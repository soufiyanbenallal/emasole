{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<div class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"></div>

<div
  class="section section--{{ section.settings.section_width }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %} spacing-style gap-style"
  style="{% render 'spacing-style', settings: section.settings %}{% render 'gap-style', value: section.settings.gap %}"
>
  <div class="hero-showcase">
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  .hero-showcase {
    display: grid;
    grid-template-columns: minmax(220px, 0.85fr) minmax(0, 2fr) minmax(260px, 1.05fr);
    align-items: stretch;
    gap: var(--gap, var(--gap-lg));
  }

  @media screen and (max-width: 989px) {
    .hero-showcase {
      grid-template-columns: 1fr;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.hero_showcase",
  "class": "hero-showcase-section",
  "blocks": [
    { "type": "hero-trust-panel" },
    { "type": "hero-promo-carousel" },
    { "type": "hero-promo-grid" }
  ],
  "settings": [
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.hero_showcase",
      "category": "t:categories.banners",
      "blocks": {
        "trust_panel": {
          "type": "hero-trust-panel",
          "blocks": {
            "item_1": {
              "type": "hero-trust-item",
              "settings": {
                "icon": "lock",
                "title": "Secure privacy",
                "description": "Your data is protected at every step."
              }
            },
            "item_2": {
              "type": "hero-trust-item",
              "settings": {
                "icon": "check_box",
                "title": "Safe payments",
                "description": "Checkout with trusted payment methods."
              }
            },
            "item_3": {
              "type": "hero-trust-item",
              "settings": {
                "icon": "truck",
                "title": "Delivery guarantee",
                "description": "Reliable shipping on every order."
              }
            }
          },
          "block_order": ["item_1", "item_2", "item_3"]
        },
        "carousel": {
          "type": "hero-promo-carousel",
          "blocks": {
            "slide_1": {
              "type": "hero-promo-slide",
              "settings": {
                "heading": "New arrivals",
                "description": "Discover what's new this week.",
                "link": "shopify://collections/all"
              }
            }
          },
          "block_order": ["slide_1"]
        },
        "grid": {
          "type": "hero-promo-grid",
          "blocks": {
            "card_1": {
              "type": "hero-promo-card",
              "settings": { "title": "Category one", "background_color": "#E96E43", "image_position": "right" }
            },
            "card_2": {
              "type": "hero-promo-card",
              "settings": { "title": "Category two", "background_color": "#3F6E8C", "image_position": "right" }
            },
            "card_3": {
              "type": "hero-promo-card",
              "settings": { "title": "Category three", "background_color": "#3E8C6B", "image_position": "right" }
            },
            "card_4": {
              "type": "hero-promo-card",
              "settings": { "title": "Category four", "background_color": "#7C5CBF", "image_position": "right" }
            }
          },
          "block_order": ["card_1", "card_2", "card_3", "card_4"]
        }
      },
      "block_order": ["trust_panel", "carousel", "grid"]
    }
  ]
}
{% endschema %}
