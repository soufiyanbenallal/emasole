{%- liquid
  assign form_id = 'EmFacets-' | append: section.id
  assign clear_url = collection.url
  if collection.sort_by != blank
    assign clear_url = collection.url | append: '?sort_by=' | append: collection.sort_by
  endif

  assign title = collection.title
  if collection.handle == 'all'
    assign title = 'emasole.collection.all_products' | t
  endif

  assign banner_image = collection.image
  if section.settings.show_image == false
    assign banner_image = blank
  endif

  assign chip_menu = linklists[collection.handle]
-%}

<div class="em-section em-collection">
  <div class="em-container">
    {%- render 'em-breadcrumbs', title: title -%}

    {%- assign price_filter = collection.filters | find: 'type', 'price_range' -%}
    <header
      class="em-collection__hero em-mesh{% if section.settings.banner_style == 'ink' %} em-mesh--ink{% endif %}{% if banner_image %} em-collection__hero--image{% endif %}"
    >
      <div class="em-collection__intro">
        <p class="em-collection__eyebrow">
          {%- render 'em-icon', icon: 'grid' -%}
          {{ 'emasole.collection.eyebrow' | t }}
        </p>
        <h1 class="em-collection__title">{{ title | escape }}</h1>
        {%- if section.settings.show_description and collection.description != blank -%}
          <div class="em-collection__desc em-rte">{{ collection.description }}</div>
        {%- endif -%}
        <ul class="em-collection__facts" role="list">
          <li class="em-collection__fact">
            {%- render 'em-icon', icon: 'package' -%}
            {{ 'emasole.collection.product_count' | t: count: collection.all_products_count }}
          </li>
          {%- if price_filter != blank and price_filter.range_max > 0 -%}
            {%- assign max_price = price_filter.range_max | money_without_trailing_zeros -%}
            <li class="em-collection__fact">
              {%- render 'em-icon', icon: 'tag' -%}
              {{ 'emasole.collection.up_to' | t: price: max_price }}
            </li>
          {%- endif -%}
        </ul>
      </div>

      <div class="em-collection__visual" aria-hidden="true">
        {%- if banner_image -%}
          <div class="em-collection__photo">
            {{
              banner_image
              | image_url: width: 1000
              | image_tag:
                loading: 'eager',
                fetchpriority: 'high',
                widths: '400, 600, 800, 1000',
                sizes: '(min-width: 990px) 420px, 50vw',
                alt: ''
            }}
          </div>
        {%- else -%}
          {%- for product in collection.products limit: 3 -%}
            {%- if product.featured_media -%}
              <figure class="em-float em-collection__float em-collection__float--{{ forloop.index }}">
                {{
                  product.featured_media
                  | image_url: width: 400
                  | image_tag: loading: 'eager', widths: '200, 300, 400', sizes: '160px', alt: ''
                }}
                <figcaption class="em-float__tag">{{ product.price | money_without_trailing_zeros }}</figcaption>
              </figure>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </div>
    </header>

    {%- if chip_menu.links.size > 0 -%}
      <nav class="em-collection__chips" aria-label="{{ 'emasole.collection.subcategories' | t }}">
        <ul class="em-collection__chip-list" role="list">
          {%- for link in chip_menu.links -%}
            <li>
              <a class="em-chip{% if link.active %} em-chip--active{% endif %}" href="{{ link.url }}">
                {{- link.title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- liquid
        assign count = collection.products_count
        assign message = 'emasole.filters.results_count' | t: count: count
      -%}
      <em-facets
        class="em-results"
        data-section-id="{{ section.id }}"
        data-currency="{{ localization.country.currency.iso_code }}"
        data-locale="{{ request.locale.iso_code }}-{{ localization.country.iso_code }}"
        data-money-format="{{ shop.money_format | strip_html | escape }}"
      >
        <p class="em-visually-hidden" role="status" data-em-results-status></p>
        <div class="em-results__layout" data-em-results data-message="{{ message | escape }}">
          <aside class="em-results__aside">
            {%- render 'em-facets',
              results: collection,
              form_id: form_id,
              clear_url: clear_url,
              count: count,
              show_filters: section.settings.enable_filtering
            -%}
          </aside>

          <div class="em-results__main" id="EmResults-{{ section.id }}">
            <div class="em-panel em-results__bar">
              {%- render 'em-facets-toolbar',
                results: collection,
                form_id: form_id,
                clear_url: clear_url,
                count: count,
                show_filters: section.settings.enable_filtering,
                show_sort: section.settings.enable_sorting,
                columns: section.settings.columns
              -%}
            </div>

            {%- if collection.products.size > 0 -%}
              <ul
                class="em-grid em-results__grid"
                role="list"
                style="--em-cols: {{ section.settings.columns }};"
                data-em-results-grid
              >
                {%- for product in collection.products -%}
                  <li>
                    {%- liquid
                      assign eager = false
                      if forloop.index <= 4 and paginate.current_page == 1
                        assign eager = true
                      endif
                    -%}
                    {%- render 'em-product-card',
                      product: product,
                      eager: eager,
                      sizes: '(min-width: 1320px) 250px, (min-width: 990px) 20vw, (min-width: 750px) 30vw, 46vw',
                      show_rating: section.settings.show_rating,
                      low_stock: section.settings.low_stock
                    -%}
                  </li>
                {%- endfor -%}
              </ul>

              {%- render 'em-pagination', paginate: paginate -%}
            {%- elsif collection.products_count == 0 and collection.all_products_count > 0 -%}
              <div class="em-panel em-empty">
                <span class="em-empty__icon">{%- render 'em-icon', icon: 'sliders' -%}</span>
                <h2 class="em-empty__title">{{ 'emasole.filters.no_matches' | t }}</h2>
                <p class="em-empty__text">{{ 'emasole.filters.no_matches_text' | t }}</p>
                <a class="em-btn" href="{{ clear_url }}" data-em-facets-link>{{ 'emasole.filters.clear_all' | t }}</a>
              </div>
            {%- elsif request.design_mode -%}
              <ul class="em-grid em-results__grid" role="list" style="--em-cols: {{ section.settings.columns }};">
                {%- for i in (1..8) -%}
                  <li>{%- render 'em-product-card', index: i -%}</li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <div class="em-panel em-empty">
                <span class="em-empty__icon">{%- render 'em-icon', icon: 'package' -%}</span>
                <h2 class="em-empty__title">{{ 'emasole.collection.empty' | t }}</h2>
                <p class="em-empty__text">{{ 'emasole.collection.empty_text' | t }}</p>
                <a class="em-btn" href="{{ routes.all_products_collection_url }}">{{ 'emasole.collection.browse_all' | t }}</a>
              </div>
            {%- endif -%}
          </div>
        </div>
      </em-facets>
    {%- endpaginate -%}
  </div>
</div>

<script src="{{ 'em-facets.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% stylesheet %}
  .em-collection__hero {
    display: grid;
    gap: var(--em-space-4);
    margin-block-start: var(--em-space-3);
    padding: var(--em-space-5) var(--em-space-4);
    border-radius: var(--em-radius-lg);
    box-shadow: var(--em-shadow-1);
  }

  .em-collection__intro {
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--em-space-3);
    min-width: 0;
  }

  .em-collection__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--em-space-2);
    margin: 0;
    padding: 4px 12px 4px 8px;
    border-radius: var(--em-radius-pill);
    background: rgb(255 255 255 / 0.75);
    color: var(--em-ember-700);
    font-size: var(--em-text-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    box-shadow: inset 0 0 0 1px rgb(255 106 43 / 0.25);
  }

  .em-collection__eyebrow .em-icon {
    width: 16px;
    height: 16px;
  }

  .em-collection__title {
    margin: 0;
    font-family: var(--em-font-display);
    font-size: var(--em-text-display);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .em-collection__desc {
    max-width: 58ch;
    color: var(--em-color-text-muted);
    font-size: var(--em-text-sm);
  }

  .em-mesh--ink .em-collection__desc {
    color: rgb(255 255 255 / 0.78);
  }

  .em-mesh--ink .em-collection__eyebrow {
    background: rgb(255 255 255 / 0.1);
    color: var(--em-sun-400);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.2);
  }

  .em-collection__facts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--em-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .em-collection__fact {
    display: inline-flex;
    align-items: center;
    gap: var(--em-space-2);
    padding: 6px 12px;
    border-radius: var(--em-radius-pill);
    background: rgb(255 255 255 / 0.8);
    color: var(--em-ink-900);
    font-size: var(--em-text-sm);
    font-weight: 700;
    box-shadow: 0 1px 2px rgb(23 23 28 / 0.08);
  }

  .em-collection__fact .em-icon {
    width: 16px;
    height: 16px;
    color: var(--em-ember-600);
  }

  .em-collection__visual {
    position: relative;
    display: none;
  }

  .em-collection__photo {
    position: absolute;
    inset: calc(var(--em-space-5) * -1) calc(var(--em-space-4) * -1) calc(var(--em-space-5) * -1) 0;
    mask: linear-gradient(90deg, transparent 0, #000 38%);
  }

  .em-collection__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .em-collection__float {
    width: 150px;
    height: 150px;
  }

  .em-collection__float--1 {
    --em-tilt: -7deg;

    inset-block-start: 4px;
    inset-inline-end: 168px;
    z-index: 2;
  }

  .em-collection__float--2 {
    --em-tilt: 5deg;

    inset-block-start: 26px;
    inset-inline-end: 12px;
    width: 172px;
    height: 172px;
    z-index: 3;
  }

  .em-collection__float--3 {
    --em-tilt: -4deg;

    inset-block-start: 56px;
    inset-inline-end: 340px;
    width: 120px;
    height: 120px;
    z-index: 1;
  }

  @media (hover: hover) {
    .em-collection__hero:hover .em-collection__float--1 {
      --em-tilt: -10deg;
    }

    .em-collection__hero:hover .em-collection__float--2 {
      --em-tilt: 8deg;
    }
  }

  @media screen and (min-width: 750px) {
    .em-collection__hero {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      min-height: 236px;
      padding: var(--em-space-6) var(--em-space-6);
    }

    .em-collection__visual {
      display: block;
      min-height: 190px;
    }

    .em-collection__photo {
      inset-inline-end: calc(var(--em-space-6) * -1);
      inset-block: calc(var(--em-space-6) * -1);
    }
  }

  .em-collection__chips {
    margin-block-start: var(--em-space-3);
  }

  .em-collection__chip-list {
    display: flex;
    gap: var(--em-space-2);
    margin: 0;
    padding: 0 0 var(--em-space-1);
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .em-collection__chip-list::-webkit-scrollbar {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:emasole.names.collection_page",
  "tag": "section",
  "class": "em-collection-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:emasole.settings.banner"
    },
    {
      "type": "select",
      "id": "banner_style",
      "label": "t:emasole.settings.banner_style",
      "options": [
        { "value": "mesh", "label": "t:emasole.options.banner_mesh" },
        { "value": "ink", "label": "t:emasole.options.banner_ink" }
      ],
      "default": "mesh"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:emasole.settings.show_collection_image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:emasole.settings.show_collection_description",
      "default": true
    },
    {
      "type": "paragraph",
      "content": "t:emasole.info.subcategory_chips"
    },
    {
      "type": "header",
      "content": "t:emasole.settings.results"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "t:emasole.settings.enable_filtering",
      "info": "t:emasole.info.filtering",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "t:emasole.settings.enable_sorting",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "t:emasole.settings.products_per_page",
      "min": 12,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:emasole.settings.columns_desktop",
      "min": 3,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "t:emasole.settings.show_rating",
      "default": true
    },
    {
      "type": "range",
      "id": "low_stock",
      "label": "t:emasole.settings.low_stock",
      "info": "t:emasole.info.low_stock",
      "min": 0,
      "max": 50,
      "step": 1,
      "default": 10
    }
  ]
}
{% endschema %}
