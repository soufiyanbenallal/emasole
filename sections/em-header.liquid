{%- liquid
  assign category_menu = section.settings.category_menu
  assign nav_menu = section.settings.nav_menu
  assign utility_menu = section.settings.utility_menu
  assign placeholders = section.settings.search_placeholders | split: ','
  assign trending = section.settings.trending_searches | split: ','
  assign first_placeholder = placeholders | first | strip | default: ''
-%}

<em-header
  class="em-header"
  data-sticky="{{ section.settings.sticky }}"
  {% if placeholders.size > 1 %}
    data-placeholders="{{ section.settings.search_placeholders | escape }}"
  {% endif %}
>
  {%- if section.settings.show_topbar -%}
    <div class="em-header__topbar">
      <div class="em-container em-header__topbar-inner">
        <p class="em-header__promo">
          {%- render 'em-icon', icon: 'truck', tone: 'mono' -%}
          {%- if section.settings.promo_link != blank -%}
            <a href="{{ section.settings.promo_link }}">{{ section.settings.promo_text | escape }}</a>
          {%- else -%}
            <span>{{ section.settings.promo_text | escape }}</span>
          {%- endif -%}
        </p>

        {%- if utility_menu.links.size > 0 -%}
          <ul class="em-header__utility" role="list">
            {%- for link in utility_menu.links -%}
              <li>
                <a href="{{ link.url }}">{{ link.title | escape }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  {%- endif -%}

  <div class="em-header__bar">
    <div class="em-container em-header__main">
      <div class="em-header__col-left">
        <button
          type="button"
          class="em-header__burger"
          popovertarget="EmDrawer-{{ section.id }}"
          aria-label="{{ 'emasole.header.open_menu' | t }}"
        >
          {%- render 'em-icon', icon: 'menu', tone: 'mono' -%}
        </button>

        <a class="em-logo" href="{{ routes.root_url }}">
          {%- if settings.logo != blank -%}
            {%- liquid
              assign logo_height = section.settings.logo_height
              assign logo_width = settings.logo.aspect_ratio | times: logo_height | round
              assign logo_width_2x = logo_width | times: 2
            -%}
            {{
              settings.logo
              | image_url: width: logo_width_2x
              | image_tag:
                class: 'em-logo__image',
                width: logo_width,
                height: logo_height,
                alt: shop.name,
                loading: 'eager',
                fetchpriority: 'high'
            }}
          {%- else -%}
            {%- render 'em-logo-mark', size: 32 -%}
            <span class="em-logo__word">{{ shop.name | escape }}</span>
          {%- endif -%}
        </a>
      </div>

      <div class="em-header__col-center">
        <search class="em-search" role="search">
          <form action="{{ routes.search_url }}" method="get" class="em-search__form">
            <input type="hidden" name="type" value="product">
            <input type="hidden" name="options[prefix]" value="last">
            <label class="em-visually-hidden" for="EmSearch-{{ section.id }}">
              {{- 'emasole.header.search_label' | t -}}
            </label>

            <span class="em-search__icon" aria-hidden="true">
              {%- render 'em-icon', icon: 'search', tone: 'mono' -%}
            </span>

            <input
              id="EmSearch-{{ section.id }}"
              class="em-search__input"
              type="search"
              name="q"
              value="{{ search.terms | escape }}"
              placeholder="{{ first_placeholder | escape }}"
              autocomplete="off"
              enterkeyhint="search"
              data-em-search-input
            >

            <button type="submit" class="em-search__submit" aria-label="{{ 'emasole.header.search_button' | t }}">
              {%- render 'em-icon', icon: 'search', tone: 'mono' -%}
              <span class="em-search__submit-text">{{ 'emasole.header.search_button' | t }}</span>
            </button>
          </form>

          {%- if trending.size > 0 -%}
            <div class="em-search__panel">
              <p class="em-search__panel-title">
                {{ 'emasole.header.trending' | t }}
              </p>
              <ul class="em-search__chips" role="list">
                {%- for term in trending -%}
                  {%- assign term_clean = term | strip -%}
                  {%- if term_clean != blank -%}
                    <li>
                      <a class="em-chip" href="{{ routes.search_url }}?type=product&q={{ term_clean | url_encode }}">
                        {{- term_clean | escape -}}
                      </a>
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </search>
      </div>

      <div class="em-header__col-right">
        <div class="em-header__actions">
          {%- if section.settings.help_link != blank -%}
            <a class="em-header__help" href="{{ section.settings.help_link }}">
              {%- render 'em-icon', icon: 'headset', tone: 'mono' -%}
              <span>{{ 'emasole.header.help' | t }}</span>
            </a>
          {%- endif -%}

          {%- render 'header-actions',
            display_style: 'icon',
            customer_account_menu: section.settings.customer_account_menu
          -%}
        </div>
      </div>
    </div>
  </div>

  {%- if category_menu.links.size > 0 or nav_menu.links.size > 0 -%}
    <nav class="em-header__nav" aria-label="{{ 'emasole.header.nav_label' | t }}">
      <div class="em-container em-header__nav-inner">
        <div class="em-header__nav-left">
          {%- if category_menu.links.size > 0 -%}
            <details class="em-mega" data-em-mega>
              <summary class="em-mega__toggle">
                {%- render 'em-icon', icon: 'grid', tone: 'mono' -%}
                <span>{{ 'emasole.header.all_categories' | t }}</span>
                {%- render 'em-icon', icon: 'chevron-down', tone: 'mono', class: 'em-mega__caret' -%}
              </summary>

              <div class="em-mega__panel">
                <div class="em-mega__shell">
                  <div class="em-mega__rail">
                    <ul class="em-mega__rail-list" role="list">
                      {%- for link in category_menu.links -%}
                        <li class="em-mega__rail-item">
                          <a class="em-mega__rail-link" href="{{ link.url }}">
                            <span>{{ link.title | escape }}</span>
                            {%- if link.links.size > 0 -%}
                              {%- render 'em-icon', icon: 'chevron-right', tone: 'mono' -%}
                            {%- endif -%}
                          </a>

                          {%- if link.links.size > 0 -%}
                            <div class="em-mega__stage">
                              <p class="em-mega__stage-title">
                                <a href="{{ link.url }}">
                                  {{- 'emasole.header.shop_all' | t: title: link.title | escape -}}
                                </a>
                              </p>
                              <div class="em-mega__groups">
                                {%- for child in link.links -%}
                                  <div class="em-mega__group">
                                    <a class="em-mega__group-title" href="{{ child.url }}">{{ child.title | escape }}</a>
                                    {%- if child.links.size > 0 -%}
                                      <ul class="em-mega__sublist" role="list">
                                        {%- for grandchild in child.links -%}
                                          <li>
                                            <a href="{{ grandchild.url }}">{{ grandchild.title | escape }}</a>
                                          </li>
                                        {%- endfor -%}
                                      </ul>
                                    {%- endif -%}
                                  </div>
                                {%- endfor -%}
                              </div>
                            </div>
                          {%- endif -%}
                        </li>
                      {%- endfor -%}
                    </ul>
                  </div>
                </div>
              </div>
            </details>
          {%- endif -%}

          {%- if nav_menu.links.size > 0 -%}
            <ul class="em-header__links" role="list">
              {%- for link in nav_menu.links -%}
                <li>
                  <a
                    class="em-header__nav-link"
                    href="{{ link.url }}"
                    {% if link.active %}
                      aria-current="page"
                    {% endif %}
                  >
                    {{- link.title | escape -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>

        <div class="em-header__nav-right">
          {%- if section.settings.highlight_label != blank -%}
            <a
              class="em-header__highlight"
              href="{{ section.settings.highlight_link | default: routes.all_products_collection_url }}"
            >
              <span class="em-header__highlight-icon" aria-hidden="true">
                {%- render 'em-icon', icon: 'bolt', tone: 'mono' -%}
              </span>
              <span>{{ section.settings.highlight_label | default: 'Flash deals' | escape }}</span>
            </a>
          {%- endif -%}
        </div>
      </div>
    </nav>
  {%- endif -%}

  <div
    id="EmDrawer-{{ section.id }}"
    class="em-drawer"
    popover
    aria-label="{{ 'emasole.header.menu' | t }}"
  >
    <div class="em-drawer__head">
      <a class="em-logo" href="{{ routes.root_url }}">
        {%- render 'em-logo-mark', size: 28 -%}
        <span class="em-logo__word">{{ shop.name | escape }}</span>
      </a>
      <button
        type="button"
        class="em-drawer__close"
        popovertarget="EmDrawer-{{ section.id }}"
        popovertargetaction="hide"
        aria-label="{{ 'emasole.header.close_menu' | t }}"
      >
        {%- render 'em-icon', icon: 'close', tone: 'mono' -%}
      </button>
    </div>

    <div class="em-drawer__body">
      {%- if shop.customer_accounts_enabled -%}
        <a class="em-drawer__account" href="{{ routes.account_url }}">
          {%- render 'em-icon', icon: 'user', tone: 'mono' -%}
          <span>
            {%- if customer -%}
              {%- assign customer_name = customer.first_name | default: customer.name -%}
              {{ 'emasole.header.greeting' | t: name: customer_name }}
            {%- else -%}
              {{ 'emasole.header.sign_in' | t }}
            {%- endif -%}
          </span>
          {%- render 'em-icon', icon: 'chevron-right', tone: 'mono' -%}
        </a>
      {%- endif -%}

      {%- if category_menu.links.size > 0 -%}
        <p class="em-drawer__label">{{ 'emasole.header.all_categories' | t }}</p>
        <ul class="em-drawer__menu" role="list">
          {%- for link in category_menu.links -%}
            <li>
              {%- if link.links.size > 0 -%}
                <details class="em-drawer__group">
                  <summary>
                    <span>{{ link.title | escape }}</span>
                    {%- render 'em-icon', icon: 'chevron-down', tone: 'mono' -%}
                  </summary>
                  <ul role="list">
                    <li>
                      <a href="{{ link.url }}">{{ 'emasole.header.shop_all' | t: title: link.title | escape }}</a>
                    </li>
                    {%- for child in link.links -%}
                      <li>
                        <a href="{{ child.url }}">{{ child.title | escape }}</a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </details>
              {%- else -%}
                <a class="em-drawer__link" href="{{ link.url }}">{{ link.title | escape }}</a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if nav_menu.links.size > 0 -%}
        <p class="em-drawer__label">{{ 'emasole.header.explore' | t }}</p>
        <ul class="em-drawer__menu" role="list">
          {%- for link in nav_menu.links -%}
            <li>
              <a class="em-drawer__link" href="{{ link.url }}">{{ link.title | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if utility_menu.links.size > 0 -%}
        <ul class="em-drawer__utility" role="list">
          {%- for link in utility_menu.links -%}
            <li>
              <a href="{{ link.url }}">{{ link.title | escape }}</a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</em-header>

{% stylesheet %}
  #header-group:has(.em-header[data-sticky='true']) {
    display: contents;
  }

  .shopify-section:has(> .em-header[data-sticky='true']) {
    position: sticky;
    top: 0;
    z-index: var(--layer-menu-drawer, 50);
  }

  /* The promo strip scrolls away; the search bar and navigation stay pinned */
  .shopify-section:has(> .em-header[data-sticky='true'] > .em-header__topbar) {
    top: -34px;
  }

  .shopify-section:has(> .em-header) {
    position: relative;
    z-index: var(--layer-menu-drawer, 50);
  }

  .em-header {
    display: block;
    background: #ffffff;
    color: #18181b;
    font-family: var(--em-font-body, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    -webkit-font-smoothing: antialiased;
  }

  .em-header[data-scrolled] .em-header__bar {
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  /* 1. TOP PROMO STRIP (Minimalist, borderless, neutral dark) */
  .em-header__topbar {
    height: 34px;
    background: #18181b;
    color: #ffffff;
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.01em;
    border: none;
  }

  .em-header__topbar-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    height: 100%;
  }

  @media screen and (min-width: 990px) {
    .em-header__topbar-inner {
      justify-content: space-between;
    }
  }

  .em-header__promo {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .em-header__promo .em-icon {
    width: 14px;
    height: 14px;
    color: #a1a1aa;
    flex-shrink: 0;
  }

  .em-header__promo a {
    color: inherit;
    text-decoration: none;
  }

  .em-header__promo a:hover {
    text-decoration: underline;
  }

  .em-header__utility {
    display: none;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 990px) {
    .em-header__utility {
      display: flex;
    }
  }

  .em-header__utility a {
    color: #ffffff;
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 120ms ease;
  }

  .em-header__utility a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  /* 2. MAIN HEADER BAR (Rounded, Borderless, True Symmetrical Centered Search) */
  .em-header__bar {
    position: relative;
    z-index: 3;
    background: #ffffff;
    border: none;
    transition: box-shadow 160ms ease;
  }

  .em-header__main {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      'burger logo actions'
      'search search search';
    align-items: center;
    column-gap: 12px;
    row-gap: 10px;
    padding-block: 10px 12px;
  }

  @media screen and (min-width: 990px) {
    .em-header__main {
      grid-template-columns: 220px 1fr 220px;
      grid-template-areas: 'logo search actions';
      column-gap: 24px;
      height: 68px;
      padding-block: 0;
    }
  }

  .em-header__col-left {
    grid-area: logo;
    display: flex;
    align-items: center;
    gap: 10px;
    justify-self: start;
  }

  .em-header__burger {
    grid-area: burger;
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    margin-inline-start: -6px;
    padding: 0;
    border: 0;
    border-radius: 9999px;
    background: #f4f4f6;
    color: #18181b;
    cursor: pointer;
    transition: background 120ms ease;
  }

  .em-header__burger:hover {
    background: #e4e4e7;
  }

  .em-header__burger .em-icon {
    width: 20px;
    height: 20px;
  }

  @media screen and (min-width: 990px) {
    .em-header__burger {
      display: none;
    }
  }

  .em-logo {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #18181b;
    text-decoration: none;
  }

  .em-logo__image {
    display: block;
    width: auto;
    max-height: 38px;
  }

  .em-logo__word {
    font-family: var(--em-font-display, var(--em-font-body));
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #18181b;
  }

  .em-logo-mark {
    flex: none;
    display: block;
  }

  /* 3. CENTERED SEARCH BAR (Rounded Pill, Soft Neutral Fill, No Border) */
  .em-header__col-center {
    grid-area: search;
    display: flex;
    justify-content: center;
    width: 100%;
    justify-self: center;
  }

  .em-search {
    position: relative;
    width: 100%;
    max-width: 580px;
    margin-inline: auto;
  }

  .em-search__form {
    display: flex;
    align-items: center;
    height: 42px;
    margin: 0;
    padding: 3px 4px 3px 16px;
    border: 0;
    border-radius: 9999px;
    background: #f4f4f6;
    transition: background 140ms ease, box-shadow 140ms ease;
  }

  .em-search__form:hover {
    background: #ededf0;
  }

  .em-search__form:focus-within {
    background: #ffffff;
    box-shadow: 0 0 0 2px #18181b, 0 4px 16px rgba(0, 0, 0, 0.06);
  }

  .em-search__icon {
    display: inline-grid;
    place-items: center;
    width: 16px;
    height: 16px;
    margin-inline-end: 10px;
    color: #71717a;
    flex-shrink: 0;
  }

  .em-search__icon .em-icon {
    width: 16px;
    height: 16px;
  }

  .em-search__input {
    flex: 1;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: 0;
    background: transparent;
    color: #18181b;
    font: inherit;
    font-size: 13.5px;
    font-weight: 400;
    outline: none;
  }

  .em-search__input::placeholder {
    color: #8e8e93;
    font-weight: 400;
  }

  .em-search__input::-webkit-search-cancel-button {
    display: none;
  }

  .em-search__submit {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    height: 34px;
    padding: 0 16px;
    border: 0;
    border-radius: 9999px;
    background: #18181b;
    color: #ffffff;
    font: inherit;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 140ms ease, transform 140ms ease;
  }

  .em-search__submit:hover {
    background: #27272a;
  }

  .em-search__submit .em-icon {
    width: 13px;
    height: 13px;
  }

  .em-search__submit-text {
    display: inline;
  }

  /* Search Panel (Rounded Floating Card, No Border) */
  .em-search__panel {
    position: absolute;
    inset-inline: 0;
    inset-block-start: calc(100% + 8px);
    z-index: 25;
    display: none;
    padding: 18px 20px;
    border-radius: 20px;
    background: #ffffff;
    border: 0;
    box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.1), 0 4px 12px rgba(0, 0, 0, 0.03);
  }

  .em-search:focus-within .em-search__panel {
    display: block;
  }

  .em-search__panel-title {
    margin: 0 0 10px;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: #71717a;
  }

  .em-search__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .em-chip {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 9999px;
    background: #f4f4f6;
    color: #27272a;
    font-size: 12px;
    font-weight: 500;
    text-decoration: none;
    border: 0;
    transition: all 120ms ease;
  }

  .em-chip:hover {
    background: #18181b;
    color: #ffffff;
  }

  /* 4. ACTIONS (Rounded buttons, no borders) */
  .em-header__col-right {
    grid-area: actions;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    justify-self: end;
  }

  .em-header__actions {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .em-header__help {
    display: none;
    align-items: center;
    gap: 6px;
    height: 36px;
    padding: 0 14px;
    border-radius: 9999px;
    background: transparent;
    color: #18181b;
    font-size: 12.5px;
    font-weight: 500;
    text-decoration: none;
    border: 0;
    transition: background 140ms ease;
  }

  .em-header__help:hover {
    background: #f4f4f6;
  }

  .em-header__help .em-icon {
    width: 15px;
    height: 15px;
    color: #71717a;
  }

  @media screen and (min-width: 990px) {
    .em-header__help {
      display: inline-flex;
    }
  }

  .em-header__actions header-actions {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .em-header__actions .header-actions__action {
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border-radius: 9999px;
    background: transparent;
    color: #18181b;
    border: 0;
    transition: background 140ms ease;
  }

  .em-header__actions .header-actions__action:hover {
    background: #f4f4f6;
  }

  .em-header__actions .svg-wrapper svg {
    width: 20px;
    height: 20px;
  }

  .em-header__actions .cart-bubble {
    background: #18181b !important;
    color: #ffffff !important;
    font-weight: 600;
    font-size: 10px;
    border-radius: 9999px;
    min-width: 17px;
    height: 17px;
  }

  /* 5. SECOND HEADER / NAV ROW (Compact 42px, Rounded elements, No Border) */
  .em-header__nav {
    display: none;
    position: relative;
    z-index: 2;
    background: #ffffff;
    border: 0;
  }

  @media screen and (min-width: 990px) {
    .em-header__nav {
      display: block;
    }
  }

  .em-header__nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    height: 44px;
  }

  .em-header__nav-left {
    display: flex;
    align-items: center;
    gap: 16px;
    min-width: 0;
    flex: 1;
    height: 100%;
  }

  .em-header__nav-right {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* All Categories Pill Button */
  .em-mega {
    position: static;
  }

  .em-mega__toggle {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 34px;
    padding: 0 16px;
    border-radius: 9999px;
    border: 0;
    background: #f4f4f6;
    color: #18181b;
    font-size: 13px;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
    white-space: nowrap;
    transition: background 140ms ease, color 140ms ease;
  }

  .em-mega__toggle::-webkit-details-marker {
    display: none;
  }

  .em-mega__toggle:hover {
    background: #e4e4e7;
  }

  .em-mega[open] .em-mega__toggle {
    background: #18181b;
    color: #ffffff;
  }

  .em-mega__toggle .em-icon {
    width: 14px;
    height: 14px;
  }

  .em-mega__caret {
    width: 10px;
    height: 10px;
    opacity: 0.7;
    transition: transform 140ms ease;
  }

  .em-mega[open] .em-mega__caret {
    transform: rotate(180deg);
  }

  /* Nav Links (Pills on hover, zero border) */
  .em-header__links {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    height: 100%;
  }

  .em-header__nav-link {
    display: inline-flex;
    align-items: center;
    height: 32px;
    padding: 0 12px;
    border-radius: 9999px;
    color: #52525b;
    font-size: 13px;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
    white-space: nowrap;
    transition: all 120ms ease;
  }

  .em-header__nav-link:hover,
  .em-header__nav-link[aria-current='page'] {
    background: #f4f4f6;
    color: #18181b;
    font-weight: 600;
  }

  /* FLASH DEALS (Luxury Rounded Pill, Borderless, Standout UI) */
  .em-header__highlight {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding: 0 14px;
    border-radius: 9999px;
    border: 0;
    background: #18181b;
    color: #ffffff;
    font-size: 12.5px;
    font-weight: 600;
    letter-spacing: 0.01em;
    text-decoration: none;
    white-space: nowrap;
    box-shadow: 0 2px 8px rgba(24, 24, 27, 0.12);
    transition: all 160ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .em-header__highlight:hover {
    background: #27272a;
    transform: translateY(-1px);
    box-shadow: 0 4px 14px rgba(24, 24, 27, 0.22);
  }

  .em-header__highlight-icon {
    display: inline-grid;
    place-items: center;
    width: 14px;
    height: 14px;
    color: #ffffff;
  }

  .em-header__highlight-icon .em-icon {
    width: 13px;
    height: 13px;
  }

  /* 6. MEGA MENU (Rounded Floating Card, No Border, Clean Multi-Column) */
  .em-mega__panel {
    position: absolute;
    inset-inline: var(--em-gutter);
    inset-block-start: calc(100% + 4px);
    max-width: var(--em-container);
    margin-inline: auto;
    padding: 10px;
    border-radius: 20px;
    background: #ffffff;
    border: 0;
    box-shadow: 0 20px 48px -12px rgba(0, 0, 0, 0.12), 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .em-mega__shell {
    position: relative;
    min-height: 340px;
  }

  .em-mega__rail {
    width: 230px;
    background: #f8f8fa;
    border-radius: 14px;
    padding: 6px;
  }

  .em-mega__rail-list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .em-mega__rail-item {
    position: static;
  }

  .em-mega__rail-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 12px;
    border-radius: 10px;
    color: #3f3f46;
    font-size: 13px;
    font-weight: 500;
    text-decoration: none;
    transition: all 120ms ease;
  }

  .em-mega__rail-link .em-icon {
    width: 12px;
    height: 12px;
    color: #a1a1aa;
  }

  .em-mega__rail-item:hover > .em-mega__rail-link,
  .em-mega__rail-item:focus-within > .em-mega__rail-link {
    background: #ffffff;
    color: #18181b;
    font-weight: 600;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
  }

  .em-mega__stage {
    position: absolute;
    inset-block: 0;
    inset-inline-start: calc(230px + 12px);
    inset-inline-end: 0;
    display: none;
    padding: 14px 20px;
    overflow-y: auto;
  }

  .em-mega__rail-item:hover > .em-mega__stage,
  .em-mega__rail-item:focus-within > .em-mega__stage,
  .em-mega__rail-list:not(:hover, :focus-within) > .em-mega__rail-item:first-child > .em-mega__stage {
    display: block;
  }

  .em-mega__stage-title {
    margin: 0 0 16px;
    font-size: 14px;
    font-weight: 600;
  }

  .em-mega__stage-title a {
    color: #18181b;
    text-decoration: none;
  }

  .em-mega__stage-title a:hover {
    text-decoration: underline;
  }

  .em-mega__groups {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 20px 24px;
  }

  .em-mega__group-title {
    display: block;
    margin-bottom: 8px;
    color: #18181b;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .em-mega__group-title:hover {
    color: #000000;
    text-decoration: underline;
  }

  .em-mega__sublist {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
  }

  .em-mega__sublist a {
    color: #52525b;
    font-size: 13px;
    font-weight: 400;
    text-decoration: none;
    transition: color 120ms ease;
  }

  .em-mega__sublist a:hover {
    color: #000000;
  }

  /* 7. MOBILE DRAWER (Rounded corners, no borders) */
  .em-drawer {
    position: fixed;
    inset: 0 auto 0 0;
    width: min(340px, 86vw);
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    border-radius: 0 20px 20px 0;
    background: #ffffff;
    color: #18181b;
    font-family: var(--em-font-body, system-ui, sans-serif);
    overflow-y: auto;
    box-shadow: 0 20px 48px rgba(0, 0, 0, 0.15);
    transition: translate 220ms ease, display 220ms allow-discrete, overlay 220ms allow-discrete;
    translate: -100% 0;
  }

  .em-drawer:popover-open {
    translate: 0 0;
  }

  @starting-style {
    .em-drawer:popover-open {
      translate: -100% 0;
    }
  }

  .em-drawer::backdrop {
    background: rgba(0, 0, 0, 0.4);
  }

  .em-drawer__head {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 18px;
    background: #ffffff;
  }

  .em-drawer__head .em-logo__word {
    font-size: 1.25rem;
  }

  .em-drawer__close {
    display: inline-grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 0;
    border-radius: 9999px;
    background: #f4f4f6;
    color: #18181b;
    cursor: pointer;
  }

  .em-drawer__close .em-icon {
    width: 14px;
    height: 14px;
  }

  .em-drawer__body {
    padding: 10px 18px 24px;
  }

  .em-drawer__account {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 14px;
    background: #f4f4f6;
    color: #18181b;
    font-weight: 600;
    font-size: 13px;
    text-decoration: none;
    margin-bottom: 16px;
  }

  .em-drawer__account span {
    flex: 1;
  }

  .em-drawer__account .em-icon {
    width: 16px;
    height: 16px;
  }

  .em-drawer__label {
    margin: 16px 0 8px;
    color: #71717a;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .em-drawer__menu,
  .em-drawer__menu ul,
  .em-drawer__utility {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .em-drawer__link,
  .em-drawer__group summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 42px;
    padding: 0 10px;
    border-radius: 10px;
    color: #18181b;
    font-weight: 500;
    font-size: 13.5px;
    text-decoration: none;
    list-style: none;
    cursor: pointer;
    border: 0;
    transition: background 120ms ease;
  }

  .em-drawer__link:hover,
  .em-drawer__group summary:hover {
    background: #f4f4f6;
  }

  .em-drawer__group summary::-webkit-details-marker {
    display: none;
  }

  .em-drawer__group summary .em-icon {
    width: 12px;
    height: 12px;
    color: #71717a;
    transition: transform 140ms ease;
  }

  .em-drawer__group[open] summary .em-icon {
    transform: rotate(180deg);
  }

  .em-drawer__group ul {
    padding: 4px 0 8px 14px;
  }

  .em-drawer__group ul a {
    display: block;
    padding: 6px 10px;
    border-radius: 8px;
    color: #52525b;
    font-size: 13px;
    text-decoration: none;
  }

  .em-drawer__group ul a:hover {
    background: #f4f4f6;
    color: #000000;
  }

  .em-drawer__utility {
    margin-top: 18px;
    gap: 8px;
    font-size: 13px;
  }

  .em-drawer__utility a {
    color: #71717a;
    text-decoration: none;
    padding: 4px 10px;
  }

  .em-drawer__utility a:hover {
    color: #18181b;
  }

  @media (prefers-reduced-motion: reduce) {
    .em-drawer {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  if (!customElements.get('em-header')) {
    class EmHeader extends HTMLElement {
      connectedCallback() {
        this.input = this.querySelector('[data-em-search-input]');
        this.mega = this.querySelector('[data-em-mega]');
        this.placeholders = (this.dataset.placeholders || '')
          .split(',')
          .map((term) => term.trim())
          .filter(Boolean);

        this.resizeObserver = new ResizeObserver(this.measure);
        this.resizeObserver.observe(this);
        window.addEventListener('scroll', this.onScroll, { passive: true });
        document.addEventListener('click', this.onDocumentClick);
        document.addEventListener('keydown', this.onKeydown);
        this.measure();
        this.onScroll();
        this.startPlaceholderRotation();
      }

      disconnectedCallback() {
        this.resizeObserver?.disconnect();
        window.removeEventListener('scroll', this.onScroll);
        document.removeEventListener('click', this.onDocumentClick);
        document.removeEventListener('keydown', this.onKeydown);
        window.clearInterval(this.placeholderTimer);
      }

      measure = () => {
        const topbar = this.querySelector('.em-header__topbar');
        const total = this.offsetHeight;
        const sticky = total - (topbar?.offsetHeight || 0);
        document.body.style.setProperty('--header-height', `${sticky}px`);
        document.body.style.setProperty('--header-group-height', `${total}px`);
      };

      onScroll = () => {
        this.toggleAttribute('data-scrolled', window.scrollY > 30);
      };

      onDocumentClick = (event) => {
        if (this.mega?.open && !this.mega.contains(event.target)) this.mega.open = false;
      };

      onKeydown = (event) => {
        if (event.key === 'Escape' && this.mega?.open) {
          this.mega.open = false;
          this.mega.querySelector('summary')?.focus();
        }
      };

      startPlaceholderRotation() {
        if (!this.input || this.placeholders.length < 2) return;
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        let index = 0;
        this.placeholderTimer = window.setInterval(() => {
          if (document.activeElement === this.input || this.input.value) return;
          index = (index + 1) % this.placeholders.length;
          this.input.placeholder = this.placeholders[index];
        }, 3200);
      }
    }

    customElements.define('em-header', EmHeader);
  }
{% endjavascript %}

{% schema %}
{
  "name": "t:emasole.names.header",
  "class": "em-header-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:emasole.settings.promo_strip"
    },
    {
      "type": "checkbox",
      "id": "show_topbar",
      "label": "t:emasole.settings.show_promo_strip",
      "default": true
    },
    {
      "type": "text",
      "id": "promo_text",
