      "info": "t:emasole.info.comma_separated",
      "default": "Earbuds,Sneakers,Smart watch,Home decor,Skincare,Toys"
    },
    {
      "type": "url",
      "id": "help_link",
      "label": "t:emasole.settings.help_link"
