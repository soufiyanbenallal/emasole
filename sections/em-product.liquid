{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'EmProductForm-' | append: section.id
  assign price = variant.price
  assign compare_at = variant.compare_at_price
  assign on_sale = false
  assign discount = 0

  if compare_at > price
    assign on_sale = true
    assign saved = compare_at | minus: price
    assign discount = saved | times: 100.0 | divided_by: compare_at | round
  endif

  if settings.currency_code_enabled_product_pages
    assign price_formatted = price | money_with_currency
    assign compare_formatted = compare_at | money_with_currency
    assign saved_formatted = saved | money_with_currency
  else
    assign price_formatted = price | money
    assign compare_formatted = compare_at | money
    assign saved_formatted = saved | money
  endif

  assign low_stock = section.settings.low_stock
  assign stock_state = 'in_stock'
  if variant == blank
    assign stock_state = 'unavailable'
  elsif variant.available == false
    assign stock_state = 'sold_out'
  elsif variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
    if low_stock > 0 and variant.inventory_quantity > 0 and variant.inventory_quantity <= low_stock
      assign stock_state = 'low'
    endif
  endif

  assign tags = product.tags | join: ',' | downcase | split: ','

  assign featured_media_id = variant.featured_media.id | default: product.featured_media.id

  assign collection_parent = collection
  if collection_parent == blank
    assign collection_parent = product.collections.first
  endif
-%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

<em-product
  class="em-section em-product"
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-variant-id="{{ variant.id }}"
  data-media-id="{{ featured_media_id }}"
>
  <div class="em-container">
    {%- render 'em-breadcrumbs',
      title: product.title,
      parent_title: collection_parent.title,
      parent_url: collection_parent.url
    -%}

    <div class="em-product__layout">
      {%- comment -%} Gallery {%- endcomment -%}
      <div class="em-product__gallery">
        <em-gallery class="em-panel em-gallery" data-media-count="{{ product.media.size }}">
          <div class="em-gallery__stage">
            <ul class="em-gallery__track" role="list" data-em-gallery-track tabindex="0" aria-label="{{ 'emasole.product.gallery' | t }}">
              {%- for media in product.media -%}
                <li
                  class="em-gallery__slide"
                  data-media-id="{{ media.id }}"
                  aria-label="{{ 'emasole.hero.slide_count' | t: index: forloop.index, count: product.media.size }}"
                >
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      {%- liquid
                        if forloop.first
                          assign media_loading = 'eager'
                          assign media_priority = 'high'
                        else
                          assign media_loading = 'lazy'
                          assign media_priority = 'auto'
                        endif
                      -%}
                      <button
                        type="button"
                        class="em-gallery__zoom"
                        data-em-zoom="{{ media | image_url: width: 2048 }}"
                        data-em-zoom-alt="{{ media.alt | default: product.title | escape }}"
                        aria-label="{{ 'emasole.product.zoom' | t: index: forloop.index }}"
                      >
                        {{
                          media
                          | image_url: width: 1400
                          | image_tag:
                            loading: media_loading,
                            fetchpriority: media_priority,
                            widths: '400, 600, 800, 1000, 1200, 1400',
                            sizes: '(min-width: 1320px) 640px, (min-width: 990px) 50vw, 100vw',
                            class: 'em-gallery__img',
                            alt: media.alt | default: product.title
                        }}
                      </button>
                    {%- else -%}
                      <div class="em-gallery__media">
                        {{ media | media_tag: image_size: '1400x' }}
                      </div>
                  {%- endcase -%}
                </li>
              {%- else -%}
                <li class="em-gallery__slide">
                  {{ 'product-1' | placeholder_svg_tag: 'em-gallery__img em-gallery__placeholder' }}
                </li>
              {%- endfor -%}
            </ul>

            <span class="em-gallery__badges" data-em-live="badges">
              {%- if on_sale -%}
                <span class="em-badge em-badge--deal">{{ 'emasole.card.discount' | t: percent: discount }}</span>
              {%- endif -%}
            </span>

            {%- if product.media.size > 1 -%}
              <span class="em-gallery__counter" aria-hidden="true">
                <span data-em-gallery-index>1</span> / {{ product.media.size }}
              </span>
              <button
                type="button"
                class="em-icon-btn em-gallery__arrow em-gallery__arrow--prev"
                data-em-gallery-prev
                aria-label="{{ 'emasole.general.previous' | t }}"
              >
                {%- render 'em-icon', icon: 'chevron-left' -%}
              </button>
              <button
                type="button"
                class="em-icon-btn em-gallery__arrow em-gallery__arrow--next"
                data-em-gallery-next
                aria-label="{{ 'emasole.general.next' | t }}"
              >
                {%- render 'em-icon', icon: 'chevron-right' -%}
              </button>
            {%- endif -%}
          </div>

          {%- if product.media.size > 1 -%}
            <ul class="em-gallery__thumbs" role="list">
              {%- for media in product.media -%}
                <li>
                  <button
                    type="button"
                    class="em-gallery__thumb"
                    data-em-gallery-thumb="{{ media.id }}"
                    aria-label="{{ 'emasole.product.show_media' | t: index: forloop.index }}"
                    {% if forloop.first %}
                      aria-current="true"
                    {% endif %}
                  >
                    {{
                      media.preview_image
                      | image_url: width: 160
                      | image_tag: loading: 'lazy', class: 'em-gallery__thumb-img', alt: ''
                    }}
                    {%- if media.media_type == 'video' or media.media_type == 'external_video' -%}
                      <span class="em-gallery__play" aria-hidden="true"></span>
                    {%- endif -%}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <dialog class="em-zoom" data-em-zoom-dialog aria-label="{{ 'emasole.product.gallery' | t }}">
            <button type="button" class="em-icon-btn em-zoom__close" data-em-zoom-close aria-label="{{ 'emasole.filters.close' | t }}">
              {%- render 'em-icon', icon: 'close' -%}
            </button>
            <img class="em-zoom__img" alt="" width="2048" height="2048" data-em-zoom-img>
          </dialog>
        </em-gallery>
      </div>

      {%- comment -%} Buy box {%- endcomment -%}
      <div class="em-product__buy">
        <div class="em-panel em-buy">
          <div class="em-buy__eyebrow">
            {%- if tags contains 'ema-pick' -%}
              <span class="em-badge em-badge--pick">{{ 'emasole.card.ema_pick' | t }}</span>
            {%- elsif tags contains 'bestseller' -%}
              <span class="em-badge em-badge--hot">{{ 'emasole.card.bestseller' | t }}</span>
            {%- elsif tags contains 'new' -%}
              <span class="em-badge em-badge--dark">{{ 'emasole.card.new' | t }}</span>
            {%- endif -%}
            {%- if section.settings.show_vendor and product.vendor != blank -%}
              <a class="em-buy__vendor" href="{{ product.vendor | url_for_vendor }}">
                {%- render 'em-icon', icon: 'badge-check' -%}
                {{ product.vendor | escape }}
              </a>
            {%- endif -%}
          </div>

          <h1 class="em-buy__title">{{ product.title | escape }}</h1>

          {%- if product.metafields.reviews.rating.value != blank -%}
            {%- liquid
              assign rating = product.metafields.reviews.rating.value.rating
              assign scale_max = product.metafields.reviews.rating.value.scale_max
              assign rating_pct = rating | times: 100.0 | divided_by: scale_max
              assign rating_count = product.metafields.reviews.rating_count.value | default: 0
            -%}
            <p class="em-buy__rating">
              <span class="em-stars" style="--em-rating: {{ rating_pct | round: 1 }}%;" aria-hidden="true"></span>
              <span class="em-buy__rating-value">{{ rating | round: 1 }}</span>
              <span class="em-visually-hidden">{{ 'emasole.card.rating' | t: rating: rating, max: scale_max }}</span>
              {%- if rating_count > 0 -%}
                <span class="em-buy__rating-count">{{ 'emasole.product.review_count' | t: count: rating_count }}</span>
              {%- endif -%}
            </p>
          {%- endif -%}

          <div class="em-buy__price-box{% if on_sale %} em-buy__price-box--sale{% endif %}" data-em-live="price">
            {%- if on_sale -%}
              <p class="em-buy__deal">
                {%- render 'em-icon', icon: 'bolt' -%}
                {{ 'emasole.product.deal' | t }}
              </p>
            {%- endif -%}
            <div class="em-price em-buy__price{% if on_sale %} em-price--sale{% endif %}">
              <span class="em-visually-hidden">
                {%- if on_sale -%}
                  {{- 'emasole.card.sale_price' | t -}}
                {%- else -%}
                  {{- 'emasole.card.price' | t -}}
                {%- endif -%}
              </span>
              <span class="em-price__current">{{ price_formatted }}</span>
              {%- if on_sale -%}
                <span class="em-visually-hidden">{{ 'emasole.card.regular_price' | t }}</span>
                <s class="em-price__compare">{{ compare_formatted }}</s>
                <span class="em-badge em-badge--deal">{{ 'emasole.card.discount' | t: percent: discount }}</span>
              {%- endif -%}
            </div>
            {%- if on_sale -%}
              <p class="em-buy__save">{{ 'emasole.card.you_save' | t: amount: saved_formatted }}</p>
            {%- endif -%}
            {%- if variant.unit_price_measurement -%}
              <p class="em-buy__note">
                <span class="em-visually-hidden">{{ 'emasole.product.unit_price' | t }}</span>
                {{ variant.unit_price | unit_price_with_measurement: variant.unit_price_measurement }}
              </p>
            {%- endif -%}
            {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
              <p class="em-buy__note">
                {%- if cart.taxes_included -%}
                  {{ 'emasole.product.taxes_included' | t }}
                {%- endif -%}
                {%- if shop.shipping_policy.body != blank -%}
                  {{ 'emasole.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                {%- endif -%}
              </p>
            {%- endif -%}
          </div>

          {%- unless product.has_only_default_variant -%}
            <div class="em-buy__options" data-em-live="options">
              {%- for option in product.options_with_values -%}
                {%- liquid
                  assign option_index = forloop.index
                  assign has_swatches = false
                  if option.values.first.swatch != blank
                    assign has_swatches = true
                  endif
                -%}
                <fieldset class="em-option" data-em-option>
                  <legend class="em-option__legend">
                    {{ option.name | escape }}:
                    <span class="em-option__selected">{{ option.selected_value | escape }}</span>
                  </legend>
                  <div class="em-option__values">
                    {%- for value in option.values -%}
                      {%- liquid
                        assign value_id = section.id | append: '-' | append: option_index | append: '-' | append: forloop.index
                      -%}
                      <input
                        class="em-option__input"
                        type="radio"
                        id="EmOption-{{ value_id }}"
                        name="EmOption-{{ section.id }}-{{ option_index }}"
                        value="{{ value | escape }}"
                        data-option-value-id="{{ value.id }}"
                        {% if value.selected %}
                          checked
                        {% endif %}
                      >
                      {%- if has_swatches and value.swatch != blank -%}
                        {%- liquid
                          if value.swatch.image
                            assign swatch_style = value.swatch.image | image_url: width: 80 | prepend: 'url(' | append: ')'
                          else
                            assign swatch_style = value.swatch.color
                          endif
                        -%}
                        <label
                          class="em-option__swatch{% unless value.available %} em-option__value--unavailable{% endunless %}"
                          for="EmOption-{{ value_id }}"
                          style="--em-swatch: {{ swatch_style }};"
                          title="{{ value | escape }}"
                        >
                          <span class="em-visually-hidden">
                            {{- value | escape -}}
                            {%- unless value.available %}, {{ 'emasole.card.sold_out' | t }}{% endunless -%}
                          </span>
                        </label>
                      {%- else -%}
                        <label
                          class="em-option__value{% unless value.available %} em-option__value--unavailable{% endunless %}"
                          for="EmOption-{{ value_id }}"
                        >
                          {{- value | escape -}}
                          {%- unless value.available -%}
                            <span class="em-visually-hidden">, {{ 'emasole.card.sold_out' | t }}</span>
                          {%- endunless -%}
                        </label>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </fieldset>
              {%- endfor -%}
            </div>
          {%- endunless -%}

          <p class="em-buy__stock em-buy__stock--{{ stock_state }}" data-em-live="stock">
            {%- case stock_state -%}
              {%- when 'low' -%}
                {%- render 'em-icon', icon: 'flame' -%}
                {{ 'emasole.card.only_left' | t: count: variant.inventory_quantity }}
              {%- when 'sold_out' -%}
                {%- render 'em-icon', icon: 'close' -%}
                {{ 'emasole.card.sold_out' | t }}
              {%- when 'unavailable' -%}
                {%- render 'em-icon', icon: 'close' -%}
                {{ 'emasole.product.unavailable' | t }}
              {%- else -%}
                {%- render 'em-icon', icon: 'check' -%}
                {{ 'emasole.product.in_stock' | t }}
            {%- endcase -%}
          </p>

          {%- form 'product', product, id: form_id, class: 'em-buy__form', novalidate: 'novalidate' -%}
            <input
              type="hidden"
              name="id"
              value="{{ variant.id }}"
              data-em-variant-input
              {% if variant == blank %}
                disabled
              {% endif %}
            >

            <div class="em-buy__actions">
              {%- if section.settings.show_quantity -%}
                <div class="em-qty" data-em-qty>
                  <button type="button" class="em-qty__btn" data-em-qty-step="-1" aria-label="{{ 'accessibility.decrease_quantity' | t }}">
                    {%- render 'em-icon', icon: 'minus' -%}
                  </button>
                  <label class="em-visually-hidden" for="EmQty-{{ section.id }}">{{ 'accessibility.quantity' | t }}</label>
                  <input
                    class="em-qty__input"
                    id="EmQty-{{ section.id }}"
                    type="number"
                    name="quantity"
                    value="1"
                    min="1"
                    {% if variant.quantity_rule.max != null %}
                      max="{{ variant.quantity_rule.max }}"
                    {% endif %}
                    step="1"
                    inputmode="numeric"
                  >
                  <button type="button" class="em-qty__btn" data-em-qty-step="1" aria-label="{{ 'accessibility.increase_quantity' | t }}">
                    {%- render 'em-icon', icon: 'plus' -%}
                  </button>
                </div>
              {%- endif -%}

              <div class="em-buy__button" data-em-live="button">
                <button
                  type="submit"
                  name="add"
                  class="em-btn em-btn--block em-buy__add"
                  data-em-add
                  {% if stock_state == 'sold_out' or stock_state == 'unavailable' %}
                    disabled
                  {% endif %}
                >
                  {%- case stock_state -%}
                    {%- when 'sold_out' -%}
                      {{ 'emasole.card.sold_out' | t }}
                    {%- when 'unavailable' -%}
                      {{ 'emasole.product.unavailable' | t }}
                    {%- else -%}
                      {%- render 'em-icon', icon: 'cart-plus' -%}
                      <span data-em-add-label>{{ 'emasole.product.add_to_cart' | t }}</span>
                  {%- endcase -%}
                </button>
              </div>
            </div>

            {%- if section.settings.show_dynamic_checkout -%}
              <div class="em-buy__checkout">{{ form | payment_button }}</div>
            {%- endif -%}

            <div class="em-buy__terms">{{ form | payment_terms }}</div>
            <p class="em-buy__error" role="alert" data-em-error hidden></p>
            <p class="em-visually-hidden" role="status" data-em-status></p>
          {%- endform -%}

          {%- assign trust_blocks = section.blocks | where: 'type', 'trust' -%}
          {%- if trust_blocks.size > 0 -%}
            <ul class="em-buy__trust" role="list">
              {%- for block in trust_blocks -%}
                <li class="em-trust" {{ block.shopify_attributes }}>
                  <span class="em-trust__icon">{%- render 'em-icon', icon: block.settings.icon -%}</span>
                  <span class="em-trust__text">
                    <strong class="em-trust__title">
                      {%- if block.settings.link != blank -%}
                        <a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>
                      {%- else -%}
                        {{ block.settings.title | escape }}
                      {%- endif -%}
                    </strong>
                    {%- if block.settings.text != blank -%}
                      <span class="em-trust__sub">{{ block.settings.text | escape }}</span>
                    {%- endif -%}
                  </span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>

      {%- comment -%} Details {%- endcomment -%}
      <div class="em-product__details">
        {%- if product.description != blank -%}
          <section class="em-panel em-details" aria-labelledby="EmDetails-{{ section.id }}">
            <h2 class="em-head__title em-details__title" id="EmDetails-{{ section.id }}">
              {%- render 'em-icon', icon: 'package' -%}
              {{ 'emasole.product.details' | t }}
            </h2>
            <div class="em-rte em-details__body">{{ product.description }}</div>
          </section>
        {%- endif -%}

        {%- for block in section.blocks -%}
          {%- if block.type == 'collapsible' -%}
            {%- liquid
              assign row_content = block.settings.content
              if block.settings.page != blank
                assign row_content = block.settings.page.content
              endif
            -%}
            {%- if row_content != blank -%}
              <details class="em-panel em-accordion" {{ block.shopify_attributes }} {% if block.settings.open %}open{% endif %}>
                <summary class="em-accordion__summary">
                  {%- render 'em-icon', icon: block.settings.icon -%}
                  <span class="em-accordion__title">{{ block.settings.heading | escape }}</span>
                  {%- render 'em-icon', icon: 'chevron-down', class: 'em-accordion__chevron' -%}
                </summary>
                <div class="em-rte em-accordion__body">{{ row_content }}</div>
              </details>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- comment -%} Mobile buy bar, shown once the main button scrolls away {%- endcomment -%}
  <div class="em-sticky-buy" data-em-sticky aria-hidden="true">
    <div class="em-sticky-buy__info">
      <span class="em-sticky-buy__title">{{ product.title | escape }}</span>
      <span class="em-sticky-buy__price{% if on_sale %} em-sticky-buy__price--sale{% endif %}" data-em-live="sticky-price">
        {{- price_formatted -}}
      </span>
    </div>
    <button
      type="submit"
      form="{{ form_id }}"
      name="add"
      class="em-btn em-btn--sm em-sticky-buy__btn"
      tabindex="-1"
      data-em-live="sticky-button"
      {% if stock_state == 'sold_out' or stock_state == 'unavailable' %}
        disabled
      {% endif %}
    >
      {%- if stock_state == 'sold_out' -%}
        {{ 'emasole.card.sold_out' | t }}
      {%- elsif stock_state == 'unavailable' -%}
        {{ 'emasole.product.unavailable' | t }}
      {%- else -%}
        {{ 'emasole.product.add_to_cart' | t }}
      {%- endif -%}
    </button>
  </div>

  <template data-em-strings>
    <span data-key="adding">{{ 'emasole.product.adding' | t }}</span>
    <span data-key="added">{{ 'emasole.product.added' | t }}</span>
    <span data-key="error">{{ 'emasole.product.error' | t }}</span>
  </template>
</em-product>

{% stylesheet %}
  .em-product {
    padding-block-end: var(--em-space-6);
  }

  .em-product__layout {
    display: grid;
    gap: var(--em-space-3);
    margin-block-start: var(--em-space-3);
  }

  .em-product__gallery,
  .em-product__buy,
  .em-product__details {
    min-width: 0;
  }

  .em-product__details {
    display: grid;
    align-content: start;
    gap: var(--em-space-3);
  }

  @media screen and (min-width: 990px) {
    .em-product__layout {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      grid-template-areas:
        'gallery buy'
        'details buy';
      grid-template-rows: auto 1fr;
      align-items: start;
      gap: var(--em-space-4);
    }

    .em-product__gallery {
      grid-area: gallery;
    }

    .em-product__buy {
      grid-area: buy;
      position: sticky;
      top: var(--em-space-4);
    }

    .em-product__details {
      grid-area: details;
    }
  }

  /* Gallery */
  .em-gallery {
    display: grid;
    gap: var(--em-space-3);
    padding: var(--em-space-3);
  }

  .em-gallery__stage {
    position: relative;
  }

  .em-gallery__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    border-radius: var(--em-radius-md);
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .em-gallery__track::-webkit-scrollbar {
    display: none;
  }

  .em-gallery__track:focus-visible {
    outline: 2px solid var(--em-color-focus);
    outline-offset: 2px;
  }

  .em-gallery__slide {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--em-ink-100);
    scroll-snap-align: start;
  }

  .em-gallery__zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .em-gallery__img,
  .em-gallery__media :is(img, video, iframe, model-viewer) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .em-gallery__media {
    display: grid;
    width: 100%;
    height: 100%;
  }

  .em-gallery__placeholder {
    fill: var(--em-ink-400);
  }

  .em-gallery__badges {
    position: absolute;
    inset-block-start: var(--em-space-3);
    inset-inline-start: var(--em-space-3);
    display: flex;
    gap: var(--em-space-1);
    pointer-events: none;
  }

  .em-gallery__badges .em-badge {
    font-size: var(--em-text-sm);
  }

  .em-gallery__counter {
    position: absolute;
    inset-block-end: var(--em-space-3);
    inset-inline-end: var(--em-space-3);
    padding: 2px var(--em-space-2);
    border-radius: var(--em-radius-pill);
    background: rgb(23 23 28 / 0.7);
    color: #ffffff;
    font-size: var(--em-text-xs);
    font-weight: 600;
    pointer-events: none;
  }

  .em-gallery__arrow {
    position: absolute;
    inset-block-start: 50%;
    display: none;
    translate: 0 -50%;
  }

  .em-gallery__arrow--prev {
    inset-inline-start: var(--em-space-3);
  }

  .em-gallery__arrow--next {
    inset-inline-end: var(--em-space-3);
  }

  .em-gallery__thumbs {
    display: flex;
    gap: var(--em-space-2);
    margin: 0;
    padding: 2px;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .em-gallery__thumbs::-webkit-scrollbar {
    display: none;
  }

  .em-gallery__thumb {
    position: relative;
    display: block;
    width: 64px;
    height: 64px;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: var(--em-radius-sm);
    background: var(--em-ink-100);
    cursor: pointer;
  }

  .em-gallery__thumb[aria-current='true'] {
    border-color: var(--em-ember-600);
  }

  .em-gallery__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .em-gallery__play::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0;
    height: 0;
    border-block: 8px solid transparent;
    border-inline-start: 13px solid #ffffff;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.5));
    translate: 2px 0;
  }

  @media screen and (min-width: 990px) {
    .em-gallery__arrow {
      display: inline-grid;
    }

    .em-gallery__counter {
      display: none;
    }

    .em-gallery__thumb {
      width: 76px;
      height: 76px;
    }
  }

  .em-zoom {
    width: 100vw;
    max-width: none;
    height: 100vh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--em-card);
  }

  .em-zoom::backdrop {
    background: rgb(23 23 28 / 0.6);
  }

  .em-zoom__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    cursor: zoom-out;
  }

  .em-zoom__close {
    position: fixed;
    inset-block-start: var(--em-space-4);
    inset-inline-end: var(--em-space-4);
    z-index: 1;
  }

  /* Buy box */
  .em-buy {
    display: grid;
    gap: var(--em-space-4);
    font-family: var(--em-font-body);
    color: var(--em-color-text);
  }

  .em-buy__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--em-space-2);
  }

  .em-buy__eyebrow:empty {
    display: none;
  }

  .em-buy__vendor {
    display: inline-flex;
    align-items: center;
    gap: var(--em-space-1);
    color: var(--em-color-text-muted);
    font-size: var(--em-text-sm);
    font-weight: 600;
    text-decoration: none;
  }

  .em-buy__vendor .em-icon {
    width: 16px;
    height: 16px;
    color: var(--em-mint-700);
  }

  .em-buy__vendor:hover {
    color: var(--em-color-action);
  }

  .em-buy__title {
    margin: calc(var(--em-space-2) * -1) 0 0;
    font-family: var(--em-font-display);
    font-size: var(--em-text-xl);
    font-weight: 700;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  @media screen and (min-width: 750px) {
    .em-buy__title {
      font-size: var(--em-text-2xl);
    }
  }

  .em-buy__rating {
    display: flex;
    align-items: center;
    gap: var(--em-space-2);
    margin: calc(var(--em-space-2) * -1) 0 0;
    font-size: var(--em-text-sm);
  }

  .em-buy__rating-value {
    font-weight: 700;
  }

  .em-buy__rating-count {
    color: var(--em-color-text-muted);
  }

  .em-buy__price-box {
    display: grid;
    gap: var(--em-space-1);
    padding: var(--em-space-3) var(--em-space-4);
    border-radius: var(--em-radius-md);
    background: var(--em-surface);
  }

  .em-buy__price-box--sale {
    background: linear-gradient(135deg, var(--em-ember-50), var(--em-sun-100));
  }

  .em-buy__deal {
    display: inline-flex;
    align-items: center;
    gap: var(--em-space-1);
    margin: 0;
    color: var(--em-ember-700);
    font-size: var(--em-text-xs);
    font-weight: 800;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .em-buy__deal .em-icon {
    width: 14px;
    height: 14px;
  }

  .em-buy__price {
    align-items: center;
  }

  .em-buy__price .em-price__current {
    font-size: var(--em-text-2xl);
    font-weight: 800;
  }

  .em-buy__price .em-price__compare {
    font-size: var(--em-text-sm);
  }

  .em-buy__save {
    margin: 0;
    color: var(--em-mint-700);
    font-size: var(--em-text-sm);
    font-weight: 700;
  }

  .em-buy__note {
    margin: 0;
    color: var(--em-color-text-muted);
    font-size: var(--em-text-xs);
  }

  .em-buy__note a {
    color: inherit;
  }

  /* Options */
  .em-buy__options {
    display: grid;
    gap: var(--em-space-4);
  }

  .em-option {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .em-option__legend {
    padding: 0;
    margin-block-end: var(--em-space-2);
    font-size: var(--em-text-sm);
    font-weight: 700;
  }

  .em-option__selected {
    color: var(--em-color-text-muted);
    font-weight: 500;
  }

  .em-option__values {
    display: flex;
    flex-wrap: wrap;
    gap: var(--em-space-2);
