  .em-option__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .em-option__value {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 var(--em-space-4);
    border: 1.5px solid var(--em-color-border);
    border-radius: var(--em-radius-sm);
    background: var(--em-card);
    font-size: var(--em-text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--em-duration) var(--em-ease);
