{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'EmProductForm-' | append: section.id
  assign price = variant.price
  assign compare_at = variant.compare_at_price
  assign on_sale = false
  assign discount = 0

  if compare_at > price
    assign on_sale = true
    assign saved = compare_at | minus: price
    assign discount = saved | times: 100.0 | divided_by: compare_at | round
  endif

  if settings.currency_code_enabled_product_pages
    assign price_formatted = price | money_with_currency
    assign compare_formatted = compare_at | money_with_currency
    assign saved_formatted = saved | money_with_currency
  else
    assign price_formatted = price | money
    assign compare_formatted = compare_at | money
    assign saved_formatted = saved | money
  endif

  assign low_stock = section.settings.low_stock
  assign stock_state = 'in_stock'
  if variant == blank
    assign stock_state = 'unavailable'
  elsif variant.available == false
    assign stock_state = 'sold_out'
  elsif variant.inventory_management == 'shopify' and variant.inventory_policy == 'deny'
    if low_stock > 0 and variant.inventory_quantity > 0 and variant.inventory_quantity <= low_stock
      assign stock_state = 'low'
      assign stock_percent = variant.inventory_quantity | times: 100.0 | divided_by: low_stock | round
    endif
  endif

  assign tags = product.tags | join: ',' | downcase | split: ','
  assign featured_media_id = variant.featured_media.id | default: product.featured_media.id

  assign collection_parent = collection
  if collection_parent == blank
    assign collection_parent = product.collections.first
  endif

  assign rule = variant.quantity_rule
  assign in_cart = 0
  if variant != blank
    assign in_cart = cart | item_count_for_variant: variant.id
  endif

  assign active_currency = localization.country.currency.iso_code
  assign multi_market = false
  if localization.available_countries.size > 1
    assign multi_market = true
  endif

  assign plan_allocations = variant.selling_plan_allocations
  assign image_count = 0
  for media in product.media
    if media.media_type == 'image'
      assign image_count = image_count | plus: 1
    endif
  endfor
-%}

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

<em-product
  class="em-section em-product"
  data-section-id="{{ section.id }}"
  data-product-url="{{ product.url }}"
  data-variant-id="{{ variant.id }}"
  data-media-id="{{ featured_media_id }}"
  data-currency="{{ active_currency }}"
  data-locale="{{ request.locale.iso_code }}-{{ localization.country.iso_code }}"
  data-money-format="{{ shop.money_format | strip_html | escape }}"
>
  <div class="em-container">
    {%- render 'em-breadcrumbs',
      title: product.title,
      parent_title: collection_parent.title,
      parent_url: collection_parent.url
    -%}

    <div class="em-product__layout">
      {%- comment -%} Gallery {%- endcomment -%}
      <div class="em-product__gallery">
        <em-gallery class="em-panel em-gallery" data-media-count="{{ product.media.size }}">
          {%- if product.media.size > 1 -%}
            <ul class="em-gallery__thumbs" role="list">
              {%- for media in product.media -%}
                <li>
                  <button
                    type="button"
                    class="em-gallery__thumb"
                    data-em-gallery-thumb="{{ media.id }}"
                    aria-label="{{ 'emasole.product.show_media' | t: index: forloop.index }}"
                    {% if forloop.first %}
                      aria-current="true"
                    {% endif %}
                  >
                    {{
                      media.preview_image
                      | image_url: width: 160
                      | image_tag: loading: 'lazy', class: 'em-gallery__thumb-img', alt: ''
                    }}
                    {%- if media.media_type != 'image' -%}
                      <span class="em-gallery__play" aria-hidden="true"></span>
                    {%- endif -%}
                  </button>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}

          <div class="em-gallery__stage">
            <ul
              class="em-gallery__track"
              role="list"
              data-em-gallery-track
              tabindex="0"
              aria-label="{{ 'emasole.product.gallery' | t }}"
            >
              {%- assign zoom_index = 0 -%}
              {%- for media in product.media -%}
                <li
                  class="em-gallery__slide"
                  data-media-id="{{ media.id }}"
                  {% if forloop.first %}
                    data-active
                  {% endif %}
                >
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      {%- liquid
                        if forloop.first
                          assign media_loading = 'eager'
                          assign media_priority = 'high'
                        else
                          assign media_loading = 'lazy'
                          assign media_priority = 'auto'
                        endif
                      -%}
                      <button
                        type="button"
                        class="em-gallery__zoom"
                        data-em-zoom
                        data-em-zoom-index="{{ zoom_index }}"
                        aria-label="{{ 'emasole.product.zoom' | t: index: forloop.index }}"
                      >
                        {{
                          media
                          | image_url: width: 1400
                          | image_tag:
                            loading: media_loading,
                            fetchpriority: media_priority,
                            widths: '400, 600, 800, 1000, 1200, 1400',
                            sizes: '(min-width: 1320px) 600px, (min-width: 990px) 46vw, 100vw',
                            class: 'em-gallery__img',
                            alt: media.alt | default: product.title
                        }}
                      </button>
                      {%- assign zoom_index = zoom_index | plus: 1 -%}
                    {%- else -%}
                      <div class="em-gallery__media">
                        {{ media | media_tag: image_size: '1400x' }}
                      </div>
                  {%- endcase -%}
                </li>
              {%- else -%}
                <li class="em-gallery__slide" data-active>
                  {{ 'product-1' | placeholder_svg_tag: 'em-gallery__img em-gallery__placeholder' }}
                </li>
              {%- endfor -%}
            </ul>

            <span class="em-gallery__badges" data-em-live="badges">
              {%- if on_sale -%}
                <span class="em-badge em-badge--deal">{{ 'emasole.card.discount' | t: percent: discount }}</span>
              {%- endif -%}
              {%- if tags contains 'ema-pick' -%}
                <span class="em-badge em-badge--pick">{{ 'emasole.card.ema_pick' | t }}</span>
              {%- elsif tags contains 'bestseller' -%}
                <span class="em-badge em-badge--hot">{{ 'emasole.card.bestseller' | t }}</span>
              {%- elsif tags contains 'new' -%}
                <span class="em-badge em-badge--dark">{{ 'emasole.card.new' | t }}</span>
              {%- endif -%}
            </span>

            <button
              type="button"
              class="em-icon-btn em-gallery__share"
              data-em-share
              aria-label="{{ 'emasole.product.share' | t }}"
            >
              {%- render 'em-icon', icon: 'share', class: 'em-gallery__share-icon' -%}
              {%- render 'em-icon', icon: 'check', class: 'em-gallery__copied-icon' -%}
            </button>

            {%- if product.media.size > 1 -%}
              <span class="em-gallery__counter" aria-hidden="true">
                <span data-em-gallery-index>1</span> / {{ product.media.size }}
              </span>
              <button
                type="button"
                class="em-icon-btn em-gallery__arrow em-gallery__arrow--prev"
                data-em-gallery-prev
                aria-label="{{ 'emasole.general.previous' | t }}"
              >
                {%- render 'em-icon', icon: 'chevron-left' -%}
              </button>
              <button
                type="button"
                class="em-icon-btn em-gallery__arrow em-gallery__arrow--next"
                data-em-gallery-next
                aria-label="{{ 'emasole.general.next' | t }}"
              >
                {%- render 'em-icon', icon: 'chevron-right' -%}
              </button>
              <div class="em-gallery__dots" role="group" aria-label="{{ 'emasole.product.gallery' | t }}">
                {%- for media in product.media -%}
                  <button
                    type="button"
                    class="em-gallery__dot"
                    data-em-gallery-dot="{{ forloop.index0 }}"
                    aria-label="{{ 'emasole.product.show_media' | t: index: forloop.index }}"
                    {% if forloop.first %}
                      aria-current="true"
                    {% endif %}
                  ></button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>

          {%- if image_count > 0 -%}
            <em-lightbox>
              <dialog class="em-lightbox" aria-label="{{ 'emasole.product.gallery' | t }}">
                <div class="em-lightbox__bar">
                  <span class="em-lightbox__count">
                    <span data-em-lightbox-index>1</span> / {{ image_count }}
                  </span>
                  <button
                    type="button"
                    class="em-icon-btn"
                    data-em-lightbox-close
                    aria-label="{{ 'emasole.filters.close' | t }}"
                  >
                    {%- render 'em-icon', icon: 'close' -%}
                  </button>
                </div>
                <div class="em-lightbox__stage">
                  {%- if image_count > 1 -%}
                    <button
                      type="button"
                      class="em-icon-btn em-lightbox__arrow em-lightbox__arrow--prev"
                      data-em-lightbox-prev
                      aria-label="{{ 'emasole.general.previous' | t }}"
                    >
                      {%- render 'em-icon', icon: 'chevron-left' -%}
                    </button>
                  {%- endif -%}
                  <img class="em-lightbox__img" alt="" width="2048" height="2048" data-em-lightbox-img>
                  {%- if image_count > 1 -%}
                    <button
                      type="button"
                      class="em-icon-btn em-lightbox__arrow em-lightbox__arrow--next"
                      data-em-lightbox-next
                      aria-label="{{ 'emasole.general.next' | t }}"
                    >
                      {%- render 'em-icon', icon: 'chevron-right' -%}
                    </button>
                  {%- endif -%}
                </div>
                {%- if image_count > 1 -%}
                  <ul class="em-lightbox__thumbs" role="list">
                    {%- for media in product.media -%}
                      {%- if media.media_type == 'image' -%}
                        <li>
                          <button
                            type="button"
                            class="em-lightbox__thumb"
                            data-em-lightbox-item
                            data-src="{{ media | image_url: width: 2048 }}"
                            data-alt="{{ media.alt | default: product.title | escape }}"
                            aria-label="{{ 'emasole.product.show_media' | t: index: forloop.index }}"
                          >
                            {{ media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
                          </button>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  </ul>
                {%- else -%}
                  {%- for media in product.media -%}
                    {%- if media.media_type == 'image' -%}
                      <span
                        hidden
                        data-em-lightbox-item
                        data-src="{{ media | image_url: width: 2048 }}"
                        data-alt="{{ media.alt | default: product.title | escape }}"
                      ></span>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endif -%}
              </dialog>
            </em-lightbox>
          {%- endif -%}
        </em-gallery>
      </div>

      {%- comment -%} Buy box {%- endcomment -%}
      <div class="em-product__buy">
        <div class="em-panel em-buy">
          <div class="em-buy__eyebrow">
            {%- if section.settings.show_vendor and product.vendor != blank -%}
              <a class="em-buy__vendor" href="{{ product.vendor | url_for_vendor }}">
                {%- render 'em-icon', icon: 'badge-check' -%}
                {{ product.vendor | escape }}
              </a>
            {%- endif -%}
            {%- if section.settings.show_type and product.type != blank -%}
              <a class="em-chip em-chip--sm" href="{{ product.type | url_for_type }}">{{ product.type | escape }}</a>
            {%- endif -%}
          </div>

          <h1 class="em-buy__title">{{ product.title | escape }}</h1>

          {%- if product.metafields.reviews.rating.value != blank -%}
            {%- liquid
              assign rating = product.metafields.reviews.rating.value.rating
              assign scale_max = product.metafields.reviews.rating.value.scale_max
              assign rating_pct = rating | times: 100.0 | divided_by: scale_max
              assign rating_count = product.metafields.reviews.rating_count.value | default: 0
            -%}
            <p class="em-buy__rating">
              <span class="em-stars" style="--em-rating: {{ rating_pct | round: 1 }}%;" aria-hidden="true"></span>
              <span class="em-buy__rating-value">{{ rating | round: 1 }}</span>
              <span class="em-visually-hidden">{{ 'emasole.card.rating' | t: rating: rating, max: scale_max }}</span>
              {%- if rating_count > 0 -%}
                <span class="em-buy__rating-count">{{ 'emasole.product.review_count' | t: count: rating_count }}</span>
              {%- endif -%}
            </p>
          {%- endif -%}

          {%- comment -%} Price {%- endcomment -%}
          <div class="em-buy__price-wrap" data-em-live="price">
            <div class="em-buy__price-box em-ticket{% if on_sale %} em-buy__price-box--sale{% endif %}">
              {%- if on_sale -%}
                <p class="em-buy__deal">
                  {%- render 'em-icon', icon: 'bolt' -%}
                  {{ 'emasole.product.deal' | t }}
                  <span class="em-badge em-badge--deal">{{ 'emasole.card.discount' | t: percent: discount }}</span>
                </p>
              {%- endif -%}
              <div class="em-price em-buy__price{% if on_sale %} em-price--sale{% endif %}">
                <span class="em-visually-hidden">
                  {%- if on_sale -%}
                    {{- 'emasole.card.sale_price' | t -}}
                  {%- else -%}
                    {{- 'emasole.card.price' | t -}}
                  {%- endif -%}
                </span>
                <span class="em-price__current">{{ price_formatted }}</span>
                {%- if on_sale -%}
                  <span class="em-visually-hidden">{{ 'emasole.card.regular_price' | t }}</span>
                  <s class="em-price__compare">{{ compare_formatted }}</s>
                {%- endif -%}
              </div>
              {%- if on_sale -%}
                <p class="em-buy__save">
                  {%- render 'em-icon', icon: 'tag' -%}
                  {{ 'emasole.card.you_save' | t: amount: saved_formatted }}
                </p>
              {%- endif -%}
            </div>

            <ul class="em-buy__notes" role="list">
              {%- if variant.unit_price_measurement -%}
                <li>
                  <span class="em-visually-hidden">{{ 'emasole.product.unit_price' | t }}</span>
                  {{ variant.unit_price | unit_price_with_measurement: variant.unit_price_measurement }}
                </li>
              {%- endif -%}
              {%- if cart.taxes_included -%}
                <li>{{ 'emasole.product.taxes_included' | t }}</li>
              {%- endif -%}
              {%- if multi_market -%}
                <li>
                  {%- render 'em-icon', icon: 'globe' -%}
                  {{ 'emasole.product.market_note' | t: country: localization.country.name, currency: active_currency }}
                </li>
              {%- endif -%}
            </ul>
          </div>

          {%- comment -%} Options {%- endcomment -%}
          {%- unless product.has_only_default_variant -%}
            <div class="em-buy__options" data-em-live="options">
              {%- for option in product.options_with_values -%}
                {%- render 'em-product-option',
                  option: option,
                  option_index: forloop.index,
                  section_id: section.id,
                  size_guide: section.settings.size_guide
                -%}
              {%- endfor -%}
            </div>
          {%- endunless -%}

          {%- comment -%} Stock {%- endcomment -%}
          <div class="em-buy__stock-wrap" data-em-live="stock">
            <p class="em-buy__stock em-buy__stock--{{ stock_state }}">
              {%- case stock_state -%}
                {%- when 'low' -%}
                  {%- render 'em-icon', icon: 'flame' -%}
                  {{ 'emasole.card.only_left' | t: count: variant.inventory_quantity }}
                {%- when 'sold_out' -%}
                  {%- render 'em-icon', icon: 'close' -%}
                  {{ 'emasole.card.sold_out' | t }}
                {%- when 'unavailable' -%}
                  {%- render 'em-icon', icon: 'close' -%}
                  {{ 'emasole.product.unavailable' | t }}
                {%- else -%}
                  {%- render 'em-icon', icon: 'check' -%}
                  {{ 'emasole.product.in_stock' | t }}
              {%- endcase -%}
            </p>
            {%- if stock_state == 'low' -%}
              <span class="em-meter" aria-hidden="true">
                <span class="em-meter__bar" style="--em-meter: {{ stock_percent }}%;"></span>
              </span>
            {%- endif -%}
          </div>

          {%- form 'product', product, id: form_id, class: 'em-buy__form', novalidate: 'novalidate' -%}
            <input
              type="hidden"
              name="id"
              value="{{ variant.id }}"
              data-em-variant-input
              {% if variant == blank %}
                disabled
              {% endif %}
            >

            <span
              hidden
              data-em-live="rules"
              data-em-rules
              data-min="{{ rule.min | default: 1 }}"
              data-max="{{ rule.max }}"
              data-step="{{ rule.increment | default: 1 }}"
              data-price="{{ price }}"
            ></span>

            {%- comment -%} Subscriptions {%- endcomment -%}
            <div data-em-live="plans">
              {%- if plan_allocations.size > 0 -%}
                <fieldset class="em-plans">
                  <legend class="em-plans__legend">{{ 'emasole.product.purchase_options' | t }}</legend>
                  <label class="em-plan">
                    <input class="em-plan__input" type="radio" name="selling_plan" value="" data-price="{{ price }}" checked>
                    <span class="em-plan__dot" aria-hidden="true"></span>
                    <span class="em-plan__text">
                      <span class="em-plan__name">{{ 'emasole.product.one_time' | t }}</span>
                    </span>
                    <span class="em-plan__price">{{ price_formatted }}</span>
                  </label>
                  {%- for allocation in plan_allocations -%}
                    {%- liquid
                      if settings.currency_code_enabled_product_pages
                        assign plan_price = allocation.price | money_with_currency
                      else
                        assign plan_price = allocation.price | money
                      endif
                      assign plan_save = allocation.compare_at_price | minus: allocation.price
                    -%}
                    <label class="em-plan">
                      <input
                        class="em-plan__input"
                        type="radio"
                        name="selling_plan"
                        value="{{ allocation.selling_plan.id }}"
                        data-price="{{ allocation.price }}"
                      >
                      <span class="em-plan__dot" aria-hidden="true"></span>
                      <span class="em-plan__text">
                        <span class="em-plan__name">{{ allocation.selling_plan.name | escape }}</span>
                        {%- if plan_save > 0 -%}
                          {%- assign plan_save_formatted = plan_save | money -%}
                          <span class="em-badge em-badge--trust">{{ 'emasole.product.plan_save' | t: amount: plan_save_formatted }}</span>
                        {%- endif -%}
                      </span>
                      <span class="em-plan__price">{{ plan_price }}</span>
                    </label>
                  {%- endfor -%}
                </fieldset>
              {%- endif -%}
            </div>

            <div class="em-buy__qty-row">
              {%- if section.settings.show_quantity -%}
                <div class="em-qty" data-em-qty>
                  <button type="button" class="em-qty__btn" data-em-qty-step="-1" aria-label="{{ 'accessibility.decrease_quantity' | t }}">
                    {%- render 'em-icon', icon: 'minus' -%}
                  </button>
                  <label class="em-visually-hidden" for="EmQty-{{ section.id }}">{{ 'accessibility.quantity' | t }}</label>
                  <input
                    class="em-qty__input"
                    id="EmQty-{{ section.id }}"
                    type="number"
                    name="quantity"
                    value="{{ rule.min | default: 1 }}"
                    min="{{ rule.min | default: 1 }}"
                    {% if rule.max != null %}
                      max="{{ rule.max }}"
                    {% endif %}
                    step="{{ rule.increment | default: 1 }}"
                    inputmode="numeric"
                  >
                  <button type="button" class="em-qty__btn" data-em-qty-step="1" aria-label="{{ 'accessibility.increase_quantity' | t }}">
                    {%- render 'em-icon', icon: 'plus' -%}
                  </button>
                </div>
              {%- endif -%}
              <div class="em-buy__qty-notes">
                <div data-em-live="qty-note">
                  {%- if rule.min > 1 or rule.increment > 1 -%}
                    <p class="em-buy__note">
                      {%- if rule.increment > 1 -%}
                        {{ 'emasole.product.quantity_rules_step' | t: min: rule.min, step: rule.increment }}
                      {%- else -%}
                        {{ 'emasole.product.quantity_rules_min' | t: min: rule.min }}
                      {%- endif -%}
                    </p>
                  {%- endif -%}
                </div>
                <p class="em-buy__total" data-em-total hidden>
                  {{ 'emasole.product.total' | t }}
                  <strong data-em-total-value></strong>
                </p>
                <div data-em-live="incart">
                  <p class="em-buy__incart" data-em-in-cart data-count="{{ in_cart }}" {% if in_cart == 0 %}hidden{% endif %}>
                    {%- render 'em-icon', icon: 'cart-plus' -%}
                    {{ 'emasole.product.in_cart_html' | t: count: in_cart }}
                  </p>
                </div>
              </div>
            </div>

            {%- assign price_breaks = variant.quantity_price_breaks -%}
            <div data-em-live="breaks">
              {%- if price_breaks.size > 0 -%}
                <div class="em-breaks">
                  <p class="em-breaks__title">{{ 'emasole.product.price_breaks' | t }}</p>
                  <ul class="em-breaks__list" role="list">
                    {%- for price_break in price_breaks -%}
                      {%- assign break_price = price_break.price | money -%}
                      <li class="em-breaks__item">
                        <span>{{ 'emasole.product.price_break_from' | t: count: price_break.minimum_quantity }}</span>
                        <strong>{{ 'emasole.product.price_break_each' | t: price: break_price }}</strong>
                      </li>
                    {%- endfor -%}
                  </ul>
                </div>
              {%- endif -%}
            </div>

            <div class="em-buy__actions" data-em-live="button">
              <button
                type="submit"
                name="add"
                class="em-btn em-btn--block em-buy__add"
                data-em-add
                {% if stock_state == 'sold_out' or stock_state == 'unavailable' %}
                  disabled
                {% endif %}
              >
                {%- case stock_state -%}
                  {%- when 'sold_out' -%}
                    {{ 'emasole.card.sold_out' | t }}
                  {%- when 'unavailable' -%}
                    {{ 'emasole.product.unavailable' | t }}
                  {%- else -%}
                    {%- render 'em-icon', icon: 'cart-plus' -%}
                    <span>{{ 'emasole.product.add_to_cart' | t }}</span>
                {%- endcase -%}
              </button>
            </div>

            {%- if section.settings.show_dynamic_checkout -%}
              <div class="em-buy__checkout">{{ form | payment_button }}</div>
            {%- endif -%}

            <div class="em-buy__terms">{{ form | payment_terms }}</div>
            <p class="em-buy__error" role="alert" data-em-error hidden></p>
            <p class="em-visually-hidden" role="status" data-em-status></p>
          {%- endform -%}

          {%- comment -%} Pickup {%- endcomment -%}
          <div data-em-live="pickup">
            {%- if section.settings.show_pickup and variant.store_availabilities.size > 0 -%}
              {%- assign pickups = variant.store_availabilities | where: 'available', true -%}
              {%- if pickups.size > 0 -%}
                <div class="em-pickup">
                  <span class="em-pickup__icon">{%- render 'em-icon', icon: 'package' -%}</span>
                  <div class="em-pickup__text">
                    <strong>{{ 'emasole.product.pickup_available' | t: location: pickups.first.location.name }}</strong>
                    <span>{{ pickups.first.pick_up_time }}</span>
                    {%- if pickups.size > 1 -%}
                      {%- assign other_pickups = pickups.size | minus: 1 -%}
                      <span>{{ 'emasole.product.pickup_more' | t: count: other_pickups }}</span>
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endif -%}
          </div>

          {%- comment -%} Reassurance built from the store's own settings {%- endcomment -%}
          {%- assign trust_blocks = section.blocks | where: 'type', 'trust' -%}
          {%- if trust_blocks.size > 0 or shop.refund_policy.body != blank or shop.shipping_policy.body != blank -%}
            <ul class="em-buy__trust" role="list">
              {%- for block in trust_blocks -%}
                <li class="em-trust" {{ block.shopify_attributes }}>
                  <span class="em-trust__icon">{%- render 'em-icon', icon: block.settings.icon -%}</span>
                  <span class="em-trust__text">
                    <strong class="em-trust__title">
                      {%- if block.settings.link != blank -%}
                        <a href="{{ block.settings.link }}">{{ block.settings.title | escape }}</a>
                      {%- else -%}
                        {{ block.settings.title | escape }}
                      {%- endif -%}
                    </strong>
                    {%- if block.settings.text != blank -%}
                      <span class="em-trust__sub">{{ block.settings.text | escape }}</span>
                    {%- endif -%}
                  </span>
                </li>
              {%- endfor -%}
              {%- if section.settings.show_policies -%}
                {%- render 'em-policy-links' -%}
              {%- endif -%}
            </ul>
          {%- endif -%}

          {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
            <div class="em-pay">
              <p class="em-pay__title">
                {%- render 'em-icon', icon: 'lock' -%}
                {{ 'emasole.product.secure_checkout' | t }}
              </p>
              <ul class="em-pay__list" role="list">
                {%- for type in shop.enabled_payment_types -%}
                  <li>{{ type | payment_type_svg_tag: class: 'em-pay__icon' }}</li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>

        {%- comment -%} Details {%- endcomment -%}
        <div class="em-product__details">
          {%- if product.description != blank -%}
            <details class="em-panel em-accordion" open>
              <summary class="em-accordion__summary">
                {%- render 'em-icon', icon: 'package' -%}
                <span class="em-accordion__title">{{ 'emasole.product.details' | t }}</span>
                {%- render 'em-icon', icon: 'chevron-down', class: 'em-accordion__chevron' -%}
              </summary>
              <div class="em-rte em-accordion__body">{{ product.description }}</div>
            </details>
          {%- endif -%}

          <details class="em-panel em-accordion"{% if product.description == blank %} open{% endif %}>
            <summary class="em-accordion__summary">
              {%- render 'em-icon', icon: 'tag' -%}
              <span class="em-accordion__title">{{ 'emasole.product.specifications' | t }}</span>
              {%- render 'em-icon', icon: 'chevron-down', class: 'em-accordion__chevron' -%}
            </summary>
            <div class="em-accordion__body" data-em-live="specs">
              {%- render 'em-product-specs', product: product, variant: variant, collection: collection_parent -%}
            </div>
          </details>

          {%- for block in section.blocks -%}
            {%- if block.type == 'collapsible' -%}
              {%- liquid
                assign row_content = block.settings.content
                if block.settings.page != blank
                  assign row_content = block.settings.page.content
                endif
              -%}
              {%- if row_content != blank -%}
                <details class="em-panel em-accordion" {{ block.shopify_attributes }} {% if block.settings.open %}open{% endif %}>
                  <summary class="em-accordion__summary">
                    {%- render 'em-icon', icon: block.settings.icon -%}
                    <span class="em-accordion__title">{{ block.settings.heading | escape }}</span>
                    {%- render 'em-icon', icon: 'chevron-down', class: 'em-accordion__chevron' -%}
                  </summary>
                  <div class="em-rte em-accordion__body">{{ row_content }}</div>
                </details>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>

  {%- comment -%} Mobile buy bar, shown once the main button scrolls away {%- endcomment -%}
  <div class="em-sticky-buy" data-em-sticky aria-hidden="true">
    {%- if product.featured_media -%}
      <span class="em-sticky-buy__thumb">
        {{ product.featured_media | image_url: width: 120 | image_tag: loading: 'lazy', alt: '' }}
      </span>
    {%- endif -%}
    <div class="em-sticky-buy__info">
      <span class="em-sticky-buy__title">{{ product.title | escape }}</span>
      <span class="em-sticky-buy__price{% if on_sale %} em-sticky-buy__price--sale{% endif %}" data-em-live="sticky-price">
        {{- price_formatted -}}
      </span>
    </div>
    <button
      type="submit"
      form="{{ form_id }}"
      name="add"
      class="em-btn em-btn--sm em-sticky-buy__btn"
      tabindex="-1"
      data-em-live="sticky-button"
      {% if stock_state == 'sold_out' or stock_state == 'unavailable' %}
        disabled
      {% endif %}
    >
      {%- if stock_state == 'sold_out' -%}
        {{ 'emasole.card.sold_out' | t }}
      {%- elsif stock_state == 'unavailable' -%}
        {{ 'emasole.product.unavailable' | t }}
      {%- else -%}
        {{ 'emasole.product.add_to_cart' | t }}
      {%- endif -%}
    </button>
  </div>

  <template data-em-strings>
    <span data-key="adding">{{ 'emasole.product.adding' | t }}</span>
    <span data-key="added">{{ 'emasole.product.added' | t }}</span>
    <span data-key="error">{{ 'emasole.product.error' | t }}</span>
    <span data-key="copied">{{ 'emasole.product.copied' | t }}</span>
  </template>
</em-product>

<script src="{{ 'em-product.js' | asset_url }}" type="module" fetchpriority="low"></script>

{% stylesheet %}
  .em-product {
    padding-block-end: var(--em-space-6);
  }

  .em-product__layout {
    display: grid;
    gap: var(--em-space-3);
    margin-block-start: var(--em-space-3);
  }

  .em-product__gallery,
  .em-product__buy {
    min-width: 0;
  }

  /* The lightbox element only hosts the dialog, which lives in the top layer */
  em-lightbox {
    display: contents;
  }

  .em-product__buy {
    display: grid;
    align-content: start;
    gap: var(--em-space-3);
  }

  .em-product__details {
    display: grid;
    align-content: start;
    gap: var(--em-space-3);
  }

  @media screen and (min-width: 990px) {
    .em-product__layout {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      align-items: start;
      gap: var(--em-space-4);
    }

    .em-product__gallery {
      position: sticky;
      top: var(--em-space-4);
    }
  }

  /* Gallery ---------------------------------------------------------------------------- */
  .em-gallery {
    display: grid;
    gap: var(--em-space-3);
    padding: var(--em-space-3);
  }

  .em-gallery__stage {
    position: relative;
    min-width: 0;
  }

  .em-gallery__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    margin: 0;
    padding: 0;
    overflow-x: auto;
    list-style: none;
    border-radius: var(--em-radius-md);
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .em-gallery__track::-webkit-scrollbar {
    display: none;
  }

  .em-gallery__track:focus-visible {
    outline: 2px solid var(--em-color-focus);
    outline-offset: 2px;
  }

  .em-gallery__slide {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background:
      radial-gradient(70% 70% at 50% 40%, #ffffff 0, transparent 100%),
      var(--em-ink-100);
    scroll-snap-align: start;
  }

  .em-gallery__zoom {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .em-gallery__img,
  .em-gallery__media :is(img, video, iframe, model-viewer) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .em-gallery__media {
    display: grid;
    width: 100%;
    height: 100%;
  }

  .em-gallery__placeholder {
    fill: var(--em-ink-400);
  }

  /* Magnify under the cursor where a mouse is available */
  @media (hover: hover) and (pointer: fine) {
    .em-gallery__zoom .em-gallery__img {
      transform-origin: var(--em-zx, 50%) var(--em-zy, 50%);
      transition: transform 260ms var(--em-ease);
    }

    .em-gallery__zoom:hover .em-gallery__img {
      transform: scale(1.9);
    }
  }

  .em-gallery__badges {
    position: absolute;
    inset-block-start: var(--em-space-3);
    inset-inline-start: var(--em-space-3);
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--em-space-1);
    pointer-events: none;
  }

  .em-gallery__badges .em-badge {
    padding: 3px 9px;
    border-radius: var(--em-radius-pill);
    font-size: var(--em-text-sm);
    box-shadow: var(--em-shadow-1);
  }

  .em-gallery__share {
    position: absolute;
    inset-block-start: var(--em-space-3);
    inset-inline-end: var(--em-space-3);
    z-index: 1;
    width: 40px;
    height: 40px;
    border-color: transparent;
    background: rgb(255 255 255 / 0.85);
    backdrop-filter: blur(8px);
  }

  .em-gallery__share .em-icon {
    width: 18px;
    height: 18px;
  }

  .em-gallery__copied-icon,
  .em-gallery__share[data-copied] .em-gallery__share-icon {
    display: none;
  }

  .em-gallery__share[data-copied] .em-gallery__copied-icon {
    display: inline-block;
    color: var(--em-mint-700);
  }

  .em-gallery__counter {
    position: absolute;
    inset-block-end: var(--em-space-3);
    inset-inline-end: var(--em-space-3);
    padding: 2px var(--em-space-2);
    border-radius: var(--em-radius-pill);
    background: rgb(23 23 28 / 0.7);
    color: #ffffff;
    font-size: var(--em-text-xs);
    font-weight: 600;
    pointer-events: none;
  }

  .em-gallery__arrow {
    position: absolute;
    inset-block-start: 50%;
    z-index: 1;
    display: none;
    translate: 0 -50%;
    opacity: 0;
    transition: opacity var(--em-duration) var(--em-ease);
  }

  .em-gallery__stage:hover .em-gallery__arrow,
  .em-gallery__arrow:focus-visible {
    opacity: 1;
  }

  .em-gallery__arrow--prev {
    inset-inline-start: var(--em-space-3);
  }

  .em-gallery__arrow--next {
    inset-inline-end: var(--em-space-3);
  }

  .em-gallery__dots {
    position: absolute;
    inset-block-end: var(--em-space-3);
    inset-inline: 0;
    display: flex;
    justify-content: center;
    gap: 6px;
    pointer-events: none;
  }

  .em-gallery__dot {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 0;
    border-radius: var(--em-radius-pill);
    background: rgb(23 23 28 / 0.25);
    transition: width var(--em-duration) var(--em-ease), background-color var(--em-duration) var(--em-ease);
    pointer-events: auto;
  }

  .em-gallery__dot[aria-current='true'] {
    width: 20px;
    background: var(--em-ember-600);
  }

  .em-gallery__thumbs {
    display: flex;
    gap: var(--em-space-2);
    margin: 0;
    padding: 2px;
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
    order: 2;
  }

  .em-gallery__thumbs::-webkit-scrollbar {
    display: none;
  }

  .em-gallery__thumb {
    position: relative;
    display: block;
    width: 64px;
    height: 64px;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: var(--em-radius-sm);
    background: var(--em-ink-100);
    cursor: pointer;
    opacity: 0.75;
    transition: opacity var(--em-duration) var(--em-ease), border-color var(--em-duration) var(--em-ease);
  }

  .em-gallery__thumb:hover {
    opacity: 1;
  }

  .em-gallery__thumb[aria-current='true'] {
    border-color: var(--em-ember-600);
    opacity: 1;
  }

  .em-gallery__thumb-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .em-gallery__play::after {
    content: '';
    position: absolute;
    inset: 0;
    margin: auto;
    width: 0;
    height: 0;
    border-block: 8px solid transparent;
    border-inline-start: 13px solid #ffffff;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.5));
    translate: 2px 0;
  }

  @media screen and (min-width: 990px) {
    .em-gallery {
      grid-template-columns: 76px minmax(0, 1fr);
      align-items: start;
    }

    .em-gallery__thumbs {
      order: 0;
      flex-direction: column;
      max-height: min(640px, 70vh);
      overflow-y: auto;
      overflow-x: hidden;
    }

    .em-gallery__thumb {
      width: 70px;
      height: 70px;
      flex: none;
    }

    .em-gallery__arrow {
      display: inline-grid;
    }

    .em-gallery__counter,
    .em-gallery__dots {
      display: none;
    }

    .em-gallery__track {
      border-radius: var(--em-radius-md);
    }
  }

  @media screen and (max-width: 989px) {
    .em-gallery__thumbs {
      display: none;
    }
  }

  /* Lightbox */
  .em-lightbox {
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: #0d0d11;
    color: #ffffff;
  }

  .em-lightbox[open] {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
  }

  .em-lightbox::backdrop {
    background: #0d0d11;
  }

  .em-lightbox__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--em-space-3) var(--em-space-4);
  }

  .em-lightbox__count {
    font-size: var(--em-text-sm);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .em-lightbox__stage {
    position: relative;
    display: grid;
    grid-template: minmax(0, 1fr) / minmax(0, 1fr);
    min-height: 0;
    padding: 0 var(--em-space-4);
  }

  /* Fill the stage and let object-fit scale the photo; percentage max-sizes would not
     resolve inside an auto-sized grid. */
  .em-lightbox__img {
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
    transition: opacity 180ms var(--em-ease);
  }

  .em-lightbox__img.is-changing {
    opacity: 0.35;
  }

  .em-lightbox__arrow {
    position: absolute;
    inset-block-start: 50%;
    z-index: 1;
    translate: 0 -50%;
  }

  .em-lightbox__arrow--prev {
    inset-inline-start: var(--em-space-4);
  }

  .em-lightbox__arrow--next {
    inset-inline-end: var(--em-space-4);
  }

  .em-lightbox__thumbs {
    display: flex;
    justify-content: center;
    gap: var(--em-space-2);
    margin: 0;
    padding: var(--em-space-3) var(--em-space-4) calc(var(--em-space-3) + env(safe-area-inset-bottom));
    overflow-x: auto;
    list-style: none;
  }

  .em-lightbox__thumb {
    display: block;
    width: 56px;
    height: 56px;
    padding: 0;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: var(--em-radius-sm);
    background: #1d1d24;
    cursor: pointer;
    opacity: 0.55;
  }

  .em-lightbox__thumb[aria-current='true'] {
    border-color: var(--em-sun-400);
    opacity: 1;
  }

  .em-lightbox__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Buy box ---------------------------------------------------------------------------- */
  .em-buy {
    display: grid;
    gap: var(--em-space-4);
    font-family: var(--em-font-body);
    color: var(--em-color-text);
  }

  .em-buy__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--em-space-2) var(--em-space-3);
  }

  .em-buy__eyebrow:empty {
    display: none;
  }

  .em-chip--sm {
    min-height: 26px;
    padding: 0 var(--em-space-2);
    font-size: var(--em-text-xs);
  }

  .em-buy__vendor {
    display: inline-flex;
    align-items: center;
    gap: var(--em-space-1);
    color: var(--em-color-text-muted);
    font-size: var(--em-text-sm);
    font-weight: 700;
    text-decoration: none;
  }

  .em-buy__vendor .em-icon {
    width: 16px;
    height: 16px;
    color: var(--em-mint-700);
  }

  .em-buy__vendor:hover {
    color: var(--em-color-action);
  }

  .em-buy__title {
    margin: calc(var(--em-space-2) * -1) 0 0;
    font-family: var(--em-font-display);
    font-size: var(--em-text-xl);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }

  @media screen and (min-width: 750px) {
    .em-buy__title {
      font-size: var(--em-text-2xl);
    }
  }

  .em-buy__rating {
    display: flex;
    align-items: center;
    gap: var(--em-space-2);
    margin: calc(var(--em-space-2) * -1) 0 0;
    font-size: var(--em-text-sm);
  }

  .em-buy__rating-value {
    font-weight: 800;
  }

  .em-buy__rating-count {
    color: var(--em-color-text-muted);
  }

  .em-buy__price-wrap {
    display: grid;
    gap: var(--em-space-2);
  }

  .em-buy__price-box {
    display: grid;
    gap: var(--em-space-1);
    padding: var(--em-space-4) var(--em-space-5);
    background: var(--em-surface);
  }

  .em-buy__price-box--sale {
    background:
      radial-gradient(80% 140% at 100% 0%, rgb(255 197 61 / 0.45) 0, transparent 60%),
      linear-gradient(135deg, var(--em-ember-50), #fff7ef);
    box-shadow: inset 0 0 0 1px var(--em-ember-100);
  }

  .em-buy__deal {
    display: flex;
    align-items: center;
    gap: var(--em-space-2);
    margin: 0;
    color: var(--em-ember-700);
    font-size: var(--em-text-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .em-buy__deal > .em-icon {
    width: 14px;
    height: 14px;
  }

  .em-buy__deal .em-badge {
    margin-inline-start: auto;
    letter-spacing: 0;
  }

  .em-buy__price {
    align-items: center;
  }

  .em-buy__price .em-price__current {
    font-size: var(--em-text-display);
    font-weight: 800;
    letter-spacing: -0.03em;
  }

  .em-buy__price .em-price__compare {
    font-size: var(--em-text-md);
  }

  .em-buy__save {
    display: inline-flex;
    align-items: center;
    gap: var(--em-space-1);
    margin: 0;
    color: var(--em-mint-700);
    font-size: var(--em-text-sm);
    font-weight: 700;
  }

  .em-buy__save .em-icon {
    width: 16px;
    height: 16px;
  }

  .em-buy__notes {
    display: grid;
    gap: 2px;
    margin: 0;
    padding: 0 var(--em-space-1);
    list-style: none;
  }

  .em-buy__notes:empty {
    display: none;
  }

  .em-buy__notes li {
    display: flex;
    align-items: center;
    gap: var(--em-space-1);
    color: var(--em-color-text-muted);
    font-size: var(--em-text-xs);
  }

  .em-buy__notes .em-icon {
    width: 14px;
    height: 14px;
  }

  .em-buy__note {
    margin: 0;
    color: var(--em-color-text-muted);
    font-size: var(--em-text-xs);
  }

  /* Options */
  .em-buy__options {
    display: grid;
    gap: var(--em-space-4);
  }

  .em-option {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .em-option__legend {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: var(--em-space-3);
    padding: 0;
    margin-block-end: var(--em-space-2);
    font-size: var(--em-text-sm);
    font-weight: 800;
  }

  .em-option__selected {
    color: var(--em-color-text-muted);
    font-weight: 500;
  }

  .em-option__guide {
    display: inline-flex;
    align-items: center;
    gap: var(--em-space-1);
    color: var(--em-color-action);
    font-weight: 700;
    text-underline-offset: 3px;
  }

  .em-option__guide .em-icon {
    width: 14px;
    height: 14px;
  }

  .em-option__values {
    display: flex;
    flex-wrap: wrap;
    gap: var(--em-space-2);
  }

  .em-option__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .em-option__value {
    display: inline-flex;
    align-items: center;
    min-height: 42px;
    padding: 0 var(--em-space-4);
    border: 1.5px solid var(--em-color-border);
    border-radius: var(--em-radius-sm);
    background: var(--em-card);
    font-size: var(--em-text-sm);
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--em-duration) var(--em-ease), background-color var(--em-duration) var(--em-ease);
  }

  .em-option__value:hover {
    border-color: var(--em-ink-900);
  }

  .em-option__swatch {
    width: 42px;
    height: 42px;
    border: 3px solid var(--em-card);
    border-radius: var(--em-radius-pill);
    background: var(--em-swatch);
    background-size: cover;
    background-position: center;
    box-shadow: 0 0 0 1px var(--em-color-border), inset 0 0 0 1px rgb(23 23 28 / 0.12);
    cursor: pointer;
    transition: box-shadow var(--em-duration) var(--em-ease), scale var(--em-duration) var(--em-ease);
  }

  .em-option__swatch:hover {
    scale: 1.06;
  }

  .em-option__input:checked + .em-option__value {
    border-color: var(--em-ember-600);
    background: var(--em-ember-50);
    color: var(--em-ember-700);
    box-shadow: 0 0 0 1px var(--em-ember-600);
  }

  .em-option__input:checked + .em-option__swatch {
    box-shadow: 0 0 0 2px var(--em-ember-600), inset 0 0 0 1px rgb(23 23 28 / 0.12);
  }

  .em-option__input:focus-visible + :is(.em-option__value, .em-option__swatch) {
    outline: 2px solid var(--em-color-focus);
    outline-offset: 3px;
  }

  .em-option__value--unavailable {
    border-style: dashed;
    color: var(--em-ink-400);
    text-decoration: line-through;
  }

  .em-option__swatch.em-option__value--unavailable {
    position: relative;
    opacity: 0.5;
  }

  .em-option__swatch.em-option__value--unavailable::after {
    content: '';
    position: absolute;
    inset: 50% -3px auto;
    height: 2px;
    background: var(--em-ink-900);
    rotate: -45deg;
  }

  em-product[data-loading] [data-em-live] {
    opacity: 0.55;
    transition: opacity var(--em-duration) var(--em-ease);
  }

  /* Stock */
  .em-buy__stock-wrap {
    display: grid;
    gap: var(--em-space-2);
  }

  .em-buy__stock {
    display: flex;
    align-items: center;
    gap: var(--em-space-2);
    margin: 0;
    font-size: var(--em-text-sm);
    font-weight: 700;
  }

  .em-buy__stock .em-icon {
    width: 18px;
    height: 18px;
  }

  .em-buy__stock--in_stock {
    color: var(--em-mint-700);
  }

  .em-buy__stock--low {
    color: var(--em-ember-700);
  }

  .em-buy__stock--sold_out,
  .em-buy__stock--unavailable {
    color: var(--em-color-text-muted);
  }

  .em-meter {
    display: block;
    height: 6px;
    overflow: hidden;
    border-radius: var(--em-radius-pill);
    background: var(--em-ember-100);
  }

  .em-meter__bar {
    display: block;
    width: var(--em-meter, 100%);
    min-width: 8%;
    height: 100%;
    border-radius: inherit;
    background: var(--em-grad-ember);
  }

  /* Purchase options (subscriptions) */
  .em-plans {
    display: grid;
    gap: var(--em-space-2);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .em-plans__legend {
    padding: 0;
    margin-block-end: var(--em-space-2);
    font-size: var(--em-text-sm);
    font-weight: 800;
  }

  .em-plan {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--em-space-3);
    padding: var(--em-space-3) var(--em-space-4);
    border: 1.5px solid var(--em-color-border);
    border-radius: var(--em-radius-md);
    background: var(--em-card);
    cursor: pointer;
    transition: border-color var(--em-duration) var(--em-ease), background-color var(--em-duration) var(--em-ease);
  }

  .em-plan:has(:checked) {
    border-color: var(--em-ember-600);
    background: var(--em-ember-50);
  }

  .em-plan:has(:focus-visible) {
    outline: 2px solid var(--em-color-focus);
    outline-offset: 2px;
  }

  .em-plan__input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .em-plan__dot {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border: 2px solid var(--em-ink-400);
    border-radius: 50%;
  }

  .em-plan:has(:checked) .em-plan__dot {
    border-color: var(--em-ember-600);
  }

  .em-plan:has(:checked) .em-plan__dot::after {
    content: '';
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--em-ember-600);
  }

  .em-plan__text {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--em-space-2);
    min-width: 0;
  }

  .em-plan__name {
    font-size: var(--em-text-sm);
    font-weight: 700;
  }

  .em-plan__price {
    font-family: var(--em-font-display);
    font-size: var(--em-text-md);
    font-weight: 800;
  }

  /* Form */
  .em-buy__form {
    display: grid;
    gap: var(--em-space-3);
    margin: 0;
  }

  .em-buy__qty-row {
    display: flex;
    align-items: center;
    gap: var(--em-space-4);
  }

  .em-buy__qty-notes {
    display: grid;
    gap: 2px;
    min-width: 0;
  }

  .em-buy__total {
    margin: 0;
    color: var(--em-color-text-muted);
    font-size: var(--em-text-sm);
  }

  .em-buy__total[hidden] {
    display: none;
  }

  .em-buy__total strong {
    color: var(--em-ink-900);
    font-family: var(--em-font-display);
    font-size: var(--em-text-md);
  }

  .em-buy__incart {
    display: flex;
    align-items: center;
    gap: var(--em-space-1);
    margin: 0;
    color: var(--em-mint-700);
    font-size: var(--em-text-xs);
    font-weight: 700;
  }

  .em-buy__incart[hidden] {
    display: none;
  }

  .em-buy__incart .em-icon {
    width: 14px;
    height: 14px;
  }

  .em-breaks {
    padding: var(--em-space-3) var(--em-space-4);
    border-radius: var(--em-radius-md);
    background: var(--em-surface);
  }

  .em-breaks__title {
    margin: 0 0 var(--em-space-2);
    font-size: var(--em-text-sm);
    font-weight: 800;
  }

  .em-breaks__list {
    display: grid;
    gap: var(--em-space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .em-breaks__item {
    display: flex;
    justify-content: space-between;
    gap: var(--em-space-3);
    font-size: var(--em-text-sm);
  }

  .em-buy__actions {
    display: grid;
  }

  .em-buy__add {
    --em-btn-bg: transparent;

    min-height: 54px;
    border-color: transparent;
    background: var(--em-grad-ember);
    box-shadow: 0 12px 24px -10px rgb(230 58 0 / 0.7);
    font-family: var(--em-font-display);
    font-size: var(--em-text-md);
    letter-spacing: 0.01em;
  }

  .em-buy__add:hover {
    --em-btn-bg: transparent;

    background: linear-gradient(135deg, #ff8a52 0%, #cc3500 100%);
  }

  .em-buy__add .em-icon {
    width: 22px;
    height: 22px;
  }

  em-product[data-adding] .em-buy__add {
    cursor: progress;
    opacity: 0.7;
  }

  em-product[data-added] .em-buy__add {
    background: linear-gradient(135deg, #12a05f 0%, #0a7a4a 100%);
    box-shadow: 0 12px 24px -10px rgb(10 122 74 / 0.7);
  }

  .em-qty {
    display: inline-flex;
    align-items: center;
    flex: none;
    border: 1.5px solid var(--em-color-border);
    border-radius: var(--em-radius-pill);
    background: var(--em-card);
  }

  .em-qty:focus-within {
    border-color: var(--em-ink-900);
  }

  .em-qty__btn {
    display: grid;
    place-items: center;
    width: 42px;
    height: 48px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--em-ink-900);
    cursor: pointer;
  }

  .em-qty__btn:hover {
    color: var(--em-color-action);
  }

  .em-qty__btn .em-icon {
    width: 16px;
    height: 16px;
  }

  .em-qty__input {
    width: 40px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--em-ink-900);
    font-family: var(--em-font-body);
    font-size: var(--em-text-md);
    font-weight: 800;
    text-align: center;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .em-qty__input:focus-visible {
    outline: none;
  }

  .em-qty__input::-webkit-outer-spin-button,
  .em-qty__input::-webkit-inner-spin-button {
    margin: 0;
    -webkit-appearance: none;
  }

  .em-buy__checkout .shopify-payment-button__button {
    min-height: 50px;
    overflow: hidden;
    border-radius: var(--em-radius-pill);
  }

  .em-buy__checkout .shopify-payment-button__button--unbranded {
    background: var(--em-ink-900);
    color: #ffffff;
    font-family: var(--em-font-display);
    font-size: var(--em-text-md);
    font-weight: 700;
  }

  .em-buy__checkout .shopify-payment-button__more-options {
    color: var(--em-color-text-muted);
    font-size: var(--em-text-xs);
  }

  .em-buy__terms:empty {
    display: none;
  }

  .em-buy__terms {
    color: var(--em-color-text-muted);
    font-size: var(--em-text-xs);
  }

  .em-buy__error {
    margin: 0;
    padding: var(--em-space-2) var(--em-space-3);
    border-radius: var(--em-radius-sm);
    background: var(--em-ember-50);
    color: var(--em-ember-700);
    font-size: var(--em-text-sm);
    font-weight: 600;
  }

  .em-buy__error[hidden] {
    display: none;
  }

  /* Pickup */
  .em-pickup {
    display: flex;
    align-items: flex-start;
    gap: var(--em-space-3);
    padding: var(--em-space-3) var(--em-space-4);
    border-radius: var(--em-radius-md);
    background: var(--em-surface);
    font-size: var(--em-text-sm);
  }

  .em-pickup__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: var(--em-radius-pill);
    background: var(--em-card);
    color: var(--em-ember-600);
  }

  .em-pickup__icon .em-icon {
    width: 18px;
    height: 18px;
  }

  .em-pickup__text {
    display: grid;
    gap: 2px;
  }

  .em-pickup__text span {
    color: var(--em-color-text-muted);
    font-size: var(--em-text-xs);
  }

  /* Trust */
  .em-buy__trust {
    display: grid;
    gap: var(--em-space-3);
    margin: 0;
    padding: var(--em-space-4);
    border-radius: var(--em-radius-md);
    background: linear-gradient(135deg, var(--em-mint-50), #f2faf5);
    box-shadow: inset 0 0 0 1px rgb(10 122 74 / 0.12);
    list-style: none;
  }

  .em-trust {
    display: flex;
    align-items: center;
    gap: var(--em-space-3);
  }

  .em-trust__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    border-radius: var(--em-radius-pill);
    background: var(--em-card);
    color: var(--em-mint-700);
    box-shadow: var(--em-shadow-1);
  }

  .em-trust__icon .em-icon {
    width: 18px;
    height: 18px;
  }

  .em-trust__text {
    display: grid;
    gap: 2px;
    font-size: var(--em-text-sm);
  }

  .em-trust__title {
    color: var(--em-ink-900);
  }

  .em-trust__title a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .em-trust__sub {
    color: var(--em-color-text-muted);
    font-size: var(--em-text-xs);
  }

  /* Payment methods the store actually accepts */
  .em-pay {
    display: grid;
    gap: var(--em-space-2);
  }

  .em-pay__title {
    display: flex;
    align-items: center;
    gap: var(--em-space-1);
    margin: 0;
    color: var(--em-color-text-muted);
    font-size: var(--em-text-xs);
    font-weight: 700;
  }

  .em-pay__title .em-icon {
    width: 14px;
    height: 14px;
  }

  .em-pay__list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--em-space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .em-pay__icon {
    display: block;
    width: 38px;
    height: 24px;
  }

  /* Details */
  .em-accordion {
    padding-block: 0;
  }

  .em-accordion__summary {
    display: flex;
    align-items: center;
    gap: var(--em-space-3);
    min-height: 58px;
    font-family: var(--em-font-display);
    font-size: var(--em-text-md);
    font-weight: 800;
    list-style: none;
    cursor: pointer;
  }

  .em-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .em-accordion__summary > .em-icon:first-child {
    color: var(--em-ember-600);
  }

  .em-accordion__title {
    flex: 1;
  }

  .em-accordion__chevron {
    transition: rotate var(--em-duration) var(--em-ease);
  }

  .em-accordion[open] .em-accordion__chevron {
    rotate: 180deg;
  }

  .em-accordion__body {
    padding-block-end: var(--em-space-4);
    font-size: var(--em-text-sm);
  }


  /* Mobile sticky buy bar */
  .em-sticky-buy {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: var(--em-space-3);
    padding: var(--em-space-2) var(--em-gutter) calc(var(--em-space-2) + env(safe-area-inset-bottom));
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(14px);
    box-shadow: 0 -6px 20px rgb(23 23 28 / 0.12);
    transform: translateY(110%);
    transition: transform 240ms var(--em-ease);
  }

  em-product[data-sticky-visible] .em-sticky-buy {
    transform: none;
  }

  .em-sticky-buy__thumb {
    flex: none;
    width: 44px;
    height: 44px;
    overflow: hidden;
    border-radius: var(--em-radius-sm);
    background: var(--em-ink-100);
  }

  .em-sticky-buy__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .em-sticky-buy__info {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .em-sticky-buy__title {
    overflow: hidden;
    color: var(--em-color-text-muted);
    font-size: var(--em-text-xs);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .em-sticky-buy__price {
    font-family: var(--em-font-display);
    font-size: var(--em-text-lg);
    font-weight: 800;
  }

  .em-sticky-buy__price--sale {
    color: var(--em-color-price);
  }

  .em-sticky-buy__btn {
    flex: none;
    min-height: 44px;
    border-color: transparent;
    background: var(--em-grad-ember);
  }

  @media screen and (max-width: 749px) {
    body:has(.em-sticky-buy) {
      padding-block-end: 72px;
    }
  }

  @media screen and (min-width: 750px) {
    .em-sticky-buy {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .em-gallery__track {
      scroll-behavior: auto;
    }

    .em-gallery__zoom:hover .em-gallery__img {
      transform: none;
    }

    .em-sticky-buy,
    .em-accordion__chevron,
    .em-option__value,
    .em-gallery__dot,
    .em-lightbox__img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:emasole.names.product_page",
  "tag": "section",
  "class": "em-product-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_vendor",
