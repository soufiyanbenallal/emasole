    {
      "type": "checkbox",
      "id": "show_dynamic_checkout",
      "label": "t:emasole.settings.show_dynamic_checkout",
      "info": "t:emasole.info.dynamic_checkout",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_pickup",
      "label": "t:emasole.settings.show_pickup",
      "info": "t:emasole.info.pickup",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:emasole.settings.show_payment_icons",
      "info": "t:emasole.info.payment_icons",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "t:emasole.settings.show_policies",
      "info": "t:emasole.info.policies",
      "default": true
    },
    {
      "type": "page",
      "id": "size_guide",
      "label": "t:emasole.settings.size_guide",
      "info": "t:emasole.info.size_guide"
    },
    {
      "type": "range",
      "id": "low_stock",
      "label": "t:emasole.settings.low_stock",
