  .em-option__value:hover {
    border-color: var(--em-ink-900);
  }

  .em-option__swatch {
    width: 40px;
    height: 40px;
    border: 2px solid var(--em-card);
    border-radius: var(--em-radius-pill);
    background: var(--em-swatch);
    background-size: cover;
    box-shadow: 0 0 0 1px var(--em-color-border);
    cursor: pointer;
  }

  .em-option__input:checked + .em-option__value {
    border-color: var(--em-ember-600);
    background: var(--em-ember-50);
    color: var(--em-ember-700);
  }

  .em-option__input:checked + .em-option__swatch {
    box-shadow: 0 0 0 2px var(--em-ember-600);
  }

  .em-option__input:focus-visible + :is(.em-option__value, .em-option__swatch) {
    outline: 2px solid var(--em-color-focus);
    outline-offset: 3px;
  }

  .em-option__value--unavailable {
    color: var(--em-ink-400);
    border-style: dashed;
    text-decoration: line-through;
  }

  .em-option__swatch.em-option__value--unavailable {
    position: relative;
    opacity: 0.5;
  }

  .em-option__swatch.em-option__value--unavailable::after {
    content: '';
    position: absolute;
    inset: 50% -2px auto;
    height: 2px;
    background: var(--em-ink-900);
    rotate: -45deg;
  }

  em-product[data-loading] [data-em-live] {
    opacity: 0.6;
    transition: opacity var(--em-duration) var(--em-ease);
  }

  /* Stock */
  .em-buy__stock {
    display: flex;
    align-items: center;
    gap: var(--em-space-2);
    margin: 0;
    font-size: var(--em-text-sm);
    font-weight: 700;
  }

  .em-buy__stock .em-icon {
    width: 18px;
    height: 18px;
  }

  .em-buy__stock--in_stock {
    color: var(--em-mint-700);
  }

  .em-buy__stock--low {
    color: var(--em-ember-700);
  }

  .em-buy__stock--sold_out,
  .em-buy__stock--unavailable {
    color: var(--em-color-text-muted);
  }

  /* Form */
  .em-buy__form {
    display: grid;
    gap: var(--em-space-3);
    margin: 0;
  }

  .em-buy__actions {
    display: flex;
    gap: var(--em-space-2);
  }

  .em-buy__button {
    flex: 1;
    min-width: 0;
  }

  .em-buy__add {
    min-height: 52px;
    font-size: var(--em-text-md);
  }

  em-product[data-adding] .em-buy__add {
    cursor: progress;
    opacity: 0.7;
  }

  em-product[data-added] .em-buy__add {
    --em-btn-bg: var(--em-mint-700);
  }

  .em-qty {
    display: inline-flex;
    align-items: center;
    flex: none;
    border: 1.5px solid var(--em-color-border);
    border-radius: var(--em-radius-pill);
    background: var(--em-card);
  }

  .em-qty__btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 48px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--em-ink-900);
    cursor: pointer;
  }

  .em-qty__btn .em-icon {
    width: 16px;
    height: 16px;
  }

  .em-qty__input {
    width: 36px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--em-ink-900);
    font-family: var(--em-font-body);
    font-size: var(--em-text-md);
    font-weight: 700;
    text-align: center;
    appearance: textfield;
    -moz-appearance: textfield;
  }

  .em-qty__input::-webkit-outer-spin-button,
  .em-qty__input::-webkit-inner-spin-button {
    margin: 0;
    -webkit-appearance: none;
  }

  .em-buy__checkout .shopify-payment-button__button {
    min-height: 48px;
    border-radius: var(--em-radius-pill);
    overflow: hidden;
  }

  .em-buy__checkout .shopify-payment-button__button--unbranded {
    background: var(--em-ink-900);
    color: #ffffff;
    font-family: var(--em-font-body);
    font-size: var(--em-text-md);
    font-weight: 700;
  }

  .em-buy__checkout .shopify-payment-button__more-options {
    color: var(--em-color-text-muted);
    font-size: var(--em-text-xs);
  }

  .em-buy__terms:empty {
    display: none;
  }

  .em-buy__terms {
    font-size: var(--em-text-xs);
    color: var(--em-color-text-muted);
  }

  .em-buy__error {
    margin: 0;
    padding: var(--em-space-2) var(--em-space-3);
    border-radius: var(--em-radius-sm);
    background: var(--em-ember-50);
    color: var(--em-ember-700);
    font-size: var(--em-text-sm);
    font-weight: 600;
  }

  .em-buy__error[hidden] {
    display: none;
  }

  /* Trust */
  .em-buy__trust {
    display: grid;
    gap: var(--em-space-3);
    margin: 0;
    padding: var(--em-space-3) var(--em-space-4);
    border-radius: var(--em-radius-md);
    background: var(--em-mint-50);
    list-style: none;
  }

  .em-trust {
    display: flex;
    align-items: flex-start;
    gap: var(--em-space-3);
  }

  .em-trust__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: var(--em-radius-pill);
    background: var(--em-card);
    color: var(--em-mint-700);
  }

  .em-trust__icon .em-icon {
    width: 18px;
    height: 18px;
  }

  .em-trust__text {
    display: grid;
    gap: 2px;
    font-size: var(--em-text-sm);
  }

  .em-trust__title {
    color: var(--em-ink-900);
  }

  .em-trust__title a {
    color: inherit;
    text-underline-offset: 3px;
  }

  .em-trust__sub {
    color: var(--em-color-text-muted);
    font-size: var(--em-text-xs);
  }

  /* Details */
  .em-details__title {
    margin-block-end: var(--em-space-4);
  }

  .em-accordion {
    padding-block: 0;
  }

  .em-accordion__summary {
    display: flex;
    align-items: center;
    gap: var(--em-space-3);
    min-height: 56px;
    font-family: var(--em-font-display);
    font-size: var(--em-text-md);
    font-weight: 700;
    list-style: none;
    cursor: pointer;
  }

  .em-accordion__summary::-webkit-details-marker {
    display: none;
  }

  .em-accordion__summary > .em-icon:first-child {
    color: var(--em-ember-600);
  }

  .em-accordion__title {
    flex: 1;
  }

  .em-accordion__chevron {
    transition: rotate var(--em-duration) var(--em-ease);
  }

  .em-accordion[open] .em-accordion__chevron {
    rotate: 180deg;
  }

  .em-accordion__body {
    padding-block-end: var(--em-space-4);
    font-size: var(--em-text-sm);
  }

  /* Mobile sticky buy bar */
  .em-sticky-buy {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 20;
    display: flex;
    align-items: center;
    gap: var(--em-space-3);
    padding: var(--em-space-2) var(--em-gutter) calc(var(--em-space-2) + env(safe-area-inset-bottom));
    background: var(--em-card);
    box-shadow: 0 -6px 20px rgb(23 23 28 / 0.12);
    transform: translateY(110%);
    transition: transform 240ms var(--em-ease);
  }

  em-product[data-sticky-visible] .em-sticky-buy {
    transform: none;
  }

  .em-sticky-buy__info {
    display: grid;
    flex: 1;
    min-width: 0;
  }

  .em-sticky-buy__title {
    overflow: hidden;
    font-size: var(--em-text-xs);
    color: var(--em-color-text-muted);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .em-sticky-buy__price {
    font-family: var(--em-font-display);
    font-size: var(--em-text-lg);
    font-weight: 800;
  }

  .em-sticky-buy__price--sale {
    color: var(--em-color-price);
  }

  .em-sticky-buy__btn {
    flex: none;
    min-height: 44px;
  }

  /* Keep the footer clear of the buy bar on phones */
  @media screen and (max-width: 749px) {
    body:has(.em-sticky-buy) {
      padding-block-end: 72px;
    }
  }

  @media screen and (min-width: 750px) {
    .em-sticky-buy {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .em-gallery__track {
      scroll-behavior: auto;
    }

    .em-sticky-buy,
    .em-accordion__chevron,
    .em-option__value {
      transition: none;
    }
  }
{% endstylesheet %}

{% javascript %}
  /**
   * Product gallery: a scroll-snap track with thumbnails, arrows, a slide counter and a
   * full-screen zoom. Swiping works without JavaScript; this keeps the controls in sync.
   */
  if (!customElements.get('em-gallery')) {
    class EmGallery extends HTMLElement {
      connectedCallback() {
        this.track = this.querySelector('[data-em-gallery-track]');
        this.slides = [...this.querySelectorAll('.em-gallery__slide')];
        this.thumbs = [...this.querySelectorAll('[data-em-gallery-thumb]')];
        this.counter = this.querySelector('[data-em-gallery-index]');
        this.dialog = this.querySelector('[data-em-zoom-dialog]');

        this.addEventListener('click', this.onClick);
        this.track?.addEventListener('keydown', this.onKeydown);

        if ('IntersectionObserver' in window && this.slides.length > 1) {
          this.observer = new IntersectionObserver(this.onIntersect, { root: this.track, threshold: 0.6 });
          this.slides.forEach((slide) => this.observer.observe(slide));
        }
      }

      disconnectedCallback() {
        this.observer?.disconnect();
      }

      get index() {
        return Math.max(0, this.slides.findIndex((slide) => slide.dataset.active === 'true'));
      }

      onIntersect = (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          this.slides.forEach((slide) => (slide.dataset.active = String(slide === entry.target)));
          this.markActive(entry.target.dataset.mediaId, this.slides.indexOf(entry.target));
        });
      };

      markActive(mediaId, index) {
        const list = this.querySelector('.em-gallery__thumbs');
        this.thumbs.forEach((thumb) => {
          const active = thumb.dataset.emGalleryThumb === mediaId;
          thumb.setAttribute('aria-current', String(active));
          if (!active || !list) return;

          // Scroll only the thumbnail strip, never the page.
          const listRect = list.getBoundingClientRect();
          const thumbRect = thumb.getBoundingClientRect();
          if (thumbRect.left < listRect.left || thumbRect.right > listRect.right) {
            list.scrollBy({ left: thumbRect.left - listRect.left - (listRect.width - thumbRect.width) / 2 });
          }
        });
        if (this.counter) this.counter.textContent = String(index + 1);
        this.querySelectorAll('video').forEach((video) => {
          if (!video.closest(`[data-media-id="${mediaId}"]`)) video.pause();
        });
      }

      goTo(index) {
        const slide = this.slides[(index + this.slides.length) % this.slides.length];
        if (!slide || !this.track) return;
        this.track.scrollTo({ left: slide.offsetLeft - this.track.offsetLeft });
      }

      select(mediaId) {
        const index = this.slides.findIndex((slide) => slide.dataset.mediaId === String(mediaId));
        if (index >= 0) this.goTo(index);
      }

      onClick = (event) => {
        const thumb = event.target.closest('[data-em-gallery-thumb]');
        if (thumb) return this.select(thumb.dataset.emGalleryThumb);

        if (event.target.closest('[data-em-gallery-prev]')) return this.goTo(this.index - 1);
        if (event.target.closest('[data-em-gallery-next]')) return this.goTo(this.index + 1);

        const zoom = event.target.closest('[data-em-zoom]');
        if (zoom && this.dialog?.showModal) return this.openZoom(zoom);

        if (event.target.closest('[data-em-zoom-close]') || event.target.closest('[data-em-zoom-img]')) {
          this.dialog?.close();
        }
      };

      onKeydown = (event) => {
        if (event.key === 'ArrowRight') {
          event.preventDefault();
          this.goTo(this.index + 1);
        } else if (event.key === 'ArrowLeft') {
          event.preventDefault();
          this.goTo(this.index - 1);
        }
      };

      openZoom(trigger) {
        const img = this.dialog.querySelector('[data-em-zoom-img]');
        img.src = trigger.dataset.emZoom;
        img.alt = trigger.dataset.emZoomAlt || '';
        this.dialog.showModal();
        this.dialog.querySelector('[data-em-zoom-close]')?.focus();
      }
    }

    customElements.define('em-gallery', EmGallery);
  }

  /**
   * Product buy box: switches variants through the Section Rendering API (so prices, stock
   * and availability are always rendered by the server), steps quantity, adds to cart
   * through Shopify's cart action, and shows a buy bar on phones once the main button
   * scrolls away. Without JavaScript the form posts to /cart/add as usual.
   */
  if (!customElements.get('em-product')) {
    class EmProduct extends HTMLElement {
      connectedCallback() {
        this.form = this.querySelector('.em-buy__form');
        this.variantInput = this.querySelector('[data-em-variant-input]');
        this.gallery = this.querySelector('em-gallery');

        this.addEventListener('change', this.onChange);
        this.addEventListener('click', this.onClick);
        this.form?.addEventListener('submit', this.onSubmit);
        this.setupStickyBar();
      }

      disconnectedCallback() {
        this.stickyObserver?.disconnect();
        this.form?.removeEventListener('submit', this.onSubmit);
      }

      string(key) {
        const template = this.querySelector('template[data-em-strings]');
        return template?.content.querySelector(`[data-key="${key}"]`)?.textContent.trim() || '';
      }

      onChange = (event) => {
        if (!event.target.matches('.em-option__input')) return;
        const ids = [...this.querySelectorAll('[data-em-option]')]
          .map((fieldset) => fieldset.querySelector('.em-option__input:checked')?.dataset.optionValueId)
          .filter(Boolean);
        this.renderVariant(ids, event.target.id);
      };

      onClick = (event) => {
        const step = event.target.closest('[data-em-qty-step]');
        if (!step) return;

        const input = this.querySelector('.em-qty__input');
        if (!input) return;
        const min = Number(input.min) || 1;
        const max = input.max ? Number(input.max) : Infinity;
        const next = (Number(input.value) || min) + Number(step.dataset.emQtyStep);
        input.value = String(Math.min(max, Math.max(min, next)));
        input.dispatchEvent(new Event('change', { bubbles: true }));
      };

      async renderVariant(optionValueIds, focusId) {
        const url = new URL(this.dataset.productUrl, window.location.origin);
        url.searchParams.set('option_values', optionValueIds.join(','));
        url.searchParams.set('section_id', this.dataset.sectionId);

        this.controller?.abort();
        this.controller = new AbortController();
        this.setAttribute('data-loading', '');

        try {
          const response = await fetch(url.toString(), { signal: this.controller.signal });
          if (!response.ok) throw new Error(response.statusText);

          const html = new DOMParser().parseFromString(await response.text(), 'text/html');
          const next = html.querySelector('em-product');
          if (!next) throw new Error('Missing product');

          this.querySelectorAll('[data-em-live]').forEach((region) => {
            const replacement = next.querySelector(`[data-em-live="${region.dataset.emLive}"]`);
            if (replacement) region.replaceWith(replacement);
          });

          const variantId = next.dataset.variantId;
          this.dataset.variantId = variantId;
          if (this.variantInput) {
            this.variantInput.value = variantId;
            this.variantInput.disabled = !variantId;
          }

          if (variantId) {
            const pageUrl = new URL(window.location.href);
            pageUrl.searchParams.set('variant', variantId);
            window.history.replaceState(window.history.state, '', pageUrl.toString());
          }

          if (next.dataset.mediaId && next.dataset.mediaId !== this.dataset.mediaId) {
            this.dataset.mediaId = next.dataset.mediaId;
            this.gallery?.select(next.dataset.mediaId);
          }

          if (focusId) document.getElementById(focusId)?.focus({ preventScroll: true });
          this.syncStickyBar();
        } catch (error) {
          if (error.name !== 'AbortError') console.error(error);
        } finally {
          this.removeAttribute('data-loading');
        }
      }

      onSubmit = async (event) => {
        const actions = window.Shopify?.actions;
        const data = new FormData(this.form);
        const hasExtras = [...data.keys()].some((key) => key.startsWith('properties') || key === 'selling_plan');
        if (!actions?.updateCart || hasExtras) return;

        event.preventDefault();
        if (this.hasAttribute('data-adding')) return;

        const id = data.get('id');
        const quantity = Math.max(1, Number(data.get('quantity')) || 1);
        const error = this.querySelector('[data-em-error]');
        const status = this.querySelector('[data-em-status]');
        if (!id) return;

        this.setAttribute('data-adding', '');
        if (error) error.hidden = true;
        if (status) status.textContent = this.string('adding');

        try {
          const result = await actions.updateCart({ lines: [{ merchandiseId: String(id), quantity }] });
          if (result?.userErrors?.length) throw new Error(result.userErrors[0].message);

          this.setAttribute('data-added', '');
          if (status) status.textContent = this.string('added');
          actions.openCart?.();
          window.setTimeout(() => this.removeAttribute('data-added'), 2000);
        } catch (err) {
          if (error) {
            error.textContent = err?.message || this.string('error');
            error.hidden = false;
          }
          if (status) status.textContent = '';
        } finally {
          this.removeAttribute('data-adding');
        }
      };

      setupStickyBar() {
        const bar = this.querySelector('[data-em-sticky]');
        const anchor = this.querySelector('.em-buy__actions');
        if (!bar || !anchor || !('IntersectionObserver' in window)) return;

        this.stickyObserver = new IntersectionObserver(([entry]) => {
          const passed = !entry.isIntersecting && entry.boundingClientRect.top < 0;
          this.toggleAttribute('data-sticky-visible', passed);
          this.syncStickyBar();
        });
        this.stickyObserver.observe(anchor);
      }

      syncStickyBar() {
        const bar = this.querySelector('[data-em-sticky]');
        if (!bar) return;
        const visible = this.hasAttribute('data-sticky-visible');
        bar.setAttribute('aria-hidden', String(!visible));
        bar.querySelectorAll('button').forEach((button) => (button.tabIndex = visible ? 0 : -1));
      }
    }

    customElements.define('em-product', EmProduct);
  }
{% endjavascript %}

