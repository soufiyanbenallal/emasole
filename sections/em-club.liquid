<div class="em-section em-club">
  <div class="em-container">
    <div class="em-club__panel">
      <div class="em-club__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="em-club__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h2 class="em-club__heading">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}
          <p class="em-club__text">{{ section.settings.text | escape }}</p>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ul class="em-club__perks" role="list">
            {%- for block in section.blocks -%}
              <li class="em-club__perk" {{ block.shopify_attributes }}>
                <span class="em-club__perk-icon">{%- render 'em-icon', icon: block.settings.icon -%}</span>
                <span>
                  <span class="em-club__perk-title">{{ block.settings.title | escape }}</span>
                  {%- if block.settings.text != blank -%}
                    <span class="em-club__perk-text">{{ block.settings.text | escape }}</span>
                  {%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="em-club__actions">
          {%- if customer -%}
            <a class="em-btn" href="{{ routes.account_url }}">{{ 'emasole.club.account' | t }}</a>
          {%- elsif shop.customer_accounts_enabled -%}
            <a class="em-btn" href="{{ routes.account_register_url }}">{{ section.settings.button_label | escape }}</a>
            <a class="em-btn em-btn--light" href="{{ routes.account_login_url }}">{{ 'emasole.hero.sign_in' | t }}</a>
          {%- else -%}
            <a class="em-btn" href="{{ section.settings.fallback_link | default: routes.all_products_collection_url }}">
              {{- section.settings.button_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </div>

      <div class="em-club__art">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 900
            | image_tag: loading: 'lazy', widths: '400, 600, 900', sizes: '(min-width: 990px) 480px, 90vw', alt: ''
          }}
        {%- else -%}
          {%- render 'em-brand-art', art: section.settings.art, tone: 'light' -%}
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% stylesheet %}
  .em-club__panel {
    --em-art-ground: var(--em-ink-900);

    position: relative;
    display: grid;
    gap: var(--em-space-5);
    overflow: hidden;
    padding: var(--em-space-5) var(--em-space-4);
    border-radius: var(--em-radius-lg);
    background: var(--em-ink-900);
    color: #ffffff;
  }

  @media screen and (min-width: 990px) {
    .em-club__panel {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
      align-items: center;
      gap: var(--em-space-7);
      padding: var(--em-space-7);
    }
  }

  .em-club__eyebrow {
    display: inline-block;
    margin: 0 0 var(--em-space-3);
    padding: 3px var(--em-space-2);
    border-radius: var(--em-radius-xs);
    background: var(--em-sun-400);
    color: var(--em-ink-900);
    font-size: var(--em-text-xs);
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .em-club__heading {
    margin: 0;
    font-family: var(--em-font-display);
    font-size: var(--em-text-2xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.1;
    text-wrap: balance;
  }

  @media screen and (min-width: 990px) {
    .em-club__heading {
      font-size: 2.5rem;
    }
  }

  .em-club__text {
    max-width: 52ch;
    margin: var(--em-space-3) 0 0;
    color: #c9c9d1;
    font-size: var(--em-text-md);
    line-height: 1.5;
  }

  .em-club__perks {
    display: grid;
    gap: var(--em-space-3);
    margin: var(--em-space-5) 0 0;
    padding: 0;
    list-style: none;
  }

  @media screen and (min-width: 750px) {
    .em-club__perks {
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    }
  }

  .em-club__perk {
    display: flex;
    align-items: flex-start;
    gap: var(--em-space-3);
  }

  .em-club__perk-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: var(--em-radius-pill);
    background: rgb(255 255 255 / 0.1);
    color: var(--em-sun-400);
  }

  .em-club__perk-icon .em-icon {
    width: 20px;
    height: 20px;
  }

  .em-club__perk-title {
    display: block;
    font-size: var(--em-text-sm);
    font-weight: 700;
  }

  .em-club__perk-text {
    display: block;
    margin-block-start: 2px;
    color: #c9c9d1;
    font-size: var(--em-text-xs);
    line-height: 1.4;
  }

  .em-club__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--em-space-2);
    margin-block-start: var(--em-space-5);
  }

  .em-club__art {
    display: grid;
    place-items: center;
    max-height: 340px;
  }

  @media screen and (max-width: 989px) {
    .em-club__art {
      display: none;
    }
  }

  .em-club__art img {
    width: 100%;
    height: 100%;
    max-height: 340px;
    object-fit: cover;
    border-radius: var(--em-radius-lg);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:emasole.names.club",
  "tag": "section",
  "class": "em-club-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:emasole.settings.eyebrow",
      "default": "Emasole Club"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:emasole.settings.heading",
      "default": "Members save more, every single day"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:emasole.settings.text",
      "default": "Create a free account to unlock member prices, early access to flash deals and a welcome coupon."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:emasole.settings.button_label",
      "default": "Join free"
    },
    {
      "type": "url",
      "id": "fallback_link",
      "label": "t:emasole.settings.link",
      "info": "t:emasole.info.club_link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:emasole.settings.image"
    },
    {
      "type": "select",
      "id": "art",
      "label": "t:emasole.settings.brand_art",
      "info": "t:emasole.info.brand_art",
      "options": [
        { "value": "bag", "label": "t:emasole.options.art_bag" },
        { "value": "badge", "label": "t:emasole.options.art_badge" },
        { "value": "gift", "label": "t:emasole.options.art_gift" },
        { "value": "tickets", "label": "t:emasole.options.art_tickets" }
      ],
      "default": "bag"
    }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "t:emasole.names.perk",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:emasole.settings.icon",
          "options": [
            { "value": "tag", "label": "t:emasole.options.icon_tag" },
            { "value": "bolt", "label": "t:emasole.options.icon_bolt" },
            { "value": "gift", "label": "t:emasole.options.icon_gift" },
            { "value": "truck", "label": "t:emasole.options.icon_truck" },
            { "value": "return", "label": "t:emasole.options.icon_return" },
            { "value": "shield", "label": "t:emasole.options.icon_shield" },
            { "value": "heart", "label": "t:emasole.options.icon_heart" }
          ],
          "default": "tag"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:emasole.settings.heading",
          "default": "Member prices"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:emasole.settings.text",
          "default": "Extra savings on thousands of items"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:emasole.names.club",
      "category": "t:emasole.names.category",
      "blocks": [
        { "type": "perk", "settings": { "icon": "tag", "title": "Member prices", "text": "Extra savings on thousands of items" } },
        { "type": "perk", "settings": { "icon": "bolt", "title": "Early access", "text": "Shop flash deals an hour before everyone" } },
        { "type": "perk", "settings": { "icon": "gift", "title": "Welcome coupon", "text": "A thank-you on your first order" } }
      ]
    }
  ]
}
{% endschema %}
