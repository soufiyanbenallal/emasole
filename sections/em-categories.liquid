{%- liquid
  assign collections_list = section.settings.collections
  assign placeholder_count = 10
-%}

<div class="em-section em-categories">
  <div class="em-container">
    <div class="em-panel">
      <div class="em-head">
        <h2 class="em-head__title">{{ section.settings.title | escape }}</h2>
        {%- if section.settings.link_label != blank -%}
          <a class="em-head__link" href="{{ section.settings.link | default: routes.collections_url }}">
            {{- section.settings.link_label | escape -}}
            {%- render 'em-icon', icon: 'chevron-right' -%}
          </a>
        {%- endif -%}
      </div>

      <em-rail class="em-rail em-categories__rail em-categories__rail--{{ section.settings.layout }}">
        <ul class="em-rail__track em-categories__track" role="list">
          {%- if collections_list.count > 0 -%}
            {%- for collection in collections_list -%}
              <li>
                <a class="em-category" href="{{ collection.url }}">
                  <span class="em-category__media">
                    {%- liquid
                      assign category_image = collection.featured_image | default: collection.products.first.featured_media.preview_image
                    -%}
                    {%- if category_image != blank -%}
                      {{
                        category_image
                        | image_url: width: 300
                        | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 110px, 80px', widths: '120, 180, 240, 300', alt: ''
                      }}
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag }}
                    {%- endif -%}
                  </span>
                  <span class="em-category__label">{{ collection.title | escape }}</span>
                </a>
              </li>
            {%- endfor -%}
          {%- else -%}
            {%- for i in (1..placeholder_count) -%}
              {%- liquid
                assign art = i | modulo: 6 | plus: 1
                assign placeholder_name = 'collection-' | append: art
              -%}
              <li>
                <span class="em-category">
                  <span class="em-category__media">{{ placeholder_name | placeholder_svg_tag }}</span>
                  <span class="em-category__label">{{ 'emasole.categories.placeholder' | t }}</span>
                </span>
              </li>
            {%- endfor -%}
          {%- endif -%}
        </ul>
        {%- render 'em-rail-arrows', label: section.settings.title -%}
      </em-rail>
    </div>
  </div>
</div>

{% stylesheet %}
  .em-categories__rail {
    --em-rail-item: 76px;
    --em-rail-gap: var(--em-space-3);
    --em-rail-arrow-top: 38%;
  }

  @media screen and (min-width: 990px) {
    .em-categories__rail {
      --em-rail-item: 112px;
      --em-rail-gap: var(--em-space-4);
    }
  }

  /* Two rows on mobile keeps more categories visible at a glance */
  @media screen and (max-width: 749px) {
    .em-categories__rail--two-rows .em-categories__track {
      grid-auto-flow: column;
      grid-template-rows: auto auto;
      row-gap: var(--em-space-4);
    }
  }

  .em-category {
    display: grid;
    justify-items: center;
    gap: var(--em-space-2);
    color: var(--em-ink-900);
    text-align: center;
    text-decoration: none;
  }

  .em-category__media {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    overflow: hidden;
    border: 2px solid transparent;
    border-radius: var(--em-radius-pill);
    background: var(--em-ink-100);
    transition: border-color var(--em-duration) var(--em-ease);
  }

  .em-category__media img,
  .em-category__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 300ms var(--em-ease);
  }

  .em-category__media svg {
    fill: var(--em-ink-400);
  }

  a.em-category:hover .em-category__media {
    border-color: var(--em-ember-600);
  }

  a.em-category:hover img {
    scale: 1.06;
  }

  .em-category__label {
    display: -webkit-box;
    overflow: hidden;
    font-size: var(--em-text-xs);
    font-weight: 600;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
  }

  @media screen and (min-width: 990px) {
    .em-category__label {
      font-size: var(--em-text-sm);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .em-category__media img {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:emasole.names.categories",
  "tag": "section",
  "class": "em-categories-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:emasole.settings.heading",
      "default": "Shop by category"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "t:emasole.settings.collections",
      "limit": 24
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:emasole.settings.mobile_layout",
      "options": [
        { "value": "two-rows", "label": "t:emasole.options.two_rows" },
        { "value": "one-row", "label": "t:emasole.options.one_row" }
      ],
      "default": "two-rows"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:emasole.settings.link_label",
      "default": "All categories"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:emasole.settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:emasole.names.categories",
      "category": "t:emasole.names.category"
    }
  ]
}
{% endschema %}
