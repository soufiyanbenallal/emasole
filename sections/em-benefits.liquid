<div class="em-section em-benefits">
  <div class="em-container">
    <ul class="em-benefits__list em-panel em-benefits__list--{{ section.settings.tone }}" role="list">
      {%- for block in section.blocks -%}
        <li class="em-benefit" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a class="em-benefit__inner" href="{{ block.settings.link }}">{%- else -%}<div class="em-benefit__inner">{%- endif -%}
            <span class="em-benefit__icon">{%- render 'em-icon', icon: block.settings.icon -%}</span>
            <span class="em-benefit__copy">
              <span class="em-benefit__title">{{ block.settings.title | escape }}</span>
              {%- if block.settings.text != blank -%}
                <span class="em-benefit__text">{{ block.settings.text | escape }}</span>
              {%- endif -%}
            </span>
          {%- if block.settings.link != blank -%}</a>{%- else -%}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .em-benefits__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(220px, 1fr);
    gap: var(--em-space-2);
    margin: 0;
    padding: var(--em-space-3);
    overflow-x: auto;
    list-style: none;
    scrollbar-width: none;
  }

  .em-benefits__list::-webkit-scrollbar {
    display: none;
  }

  @media screen and (min-width: 750px) {
    .em-benefits__list {
      padding: var(--em-space-3) var(--em-space-4);
    }
  }

  .em-benefits__list--mint {
    background: var(--em-mint-50);
  }

  .em-benefit__inner {
    display: flex;
    align-items: center;
    gap: var(--em-space-3);
    height: 100%;
    padding: var(--em-space-2);
    border-radius: var(--em-radius-md);
    color: var(--em-ink-900);
    text-decoration: none;
  }

  a.em-benefit__inner:hover {
    background: rgb(23 23 28 / 0.04);
  }

  .em-benefit__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: var(--em-radius-pill);
    background: var(--em-mint-50);
    color: var(--em-mint-700);
  }

  .em-benefits__list--mint .em-benefit__icon {
    background: var(--em-card);
  }

  .em-benefit__copy {
    display: grid;
    gap: 2px;
  }

  .em-benefit__title {
    font-size: var(--em-text-sm);
    font-weight: 700;
    line-height: 1.25;
  }

  .em-benefit__text {
    color: var(--em-color-text-muted);
    font-size: var(--em-text-xs);
    line-height: 1.35;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:emasole.names.benefits",
  "tag": "section",
  "class": "em-benefits-section",
  "disabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "tone",
      "label": "t:emasole.settings.background",
      "options": [
        { "value": "white", "label": "t:emasole.options.white" },
        { "value": "mint", "label": "t:emasole.options.mint" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "t:emasole.names.benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:emasole.settings.icon",
          "options": [
            { "value": "truck", "label": "t:emasole.options.icon_truck" },
            { "value": "return", "label": "t:emasole.options.icon_return" },
            { "value": "shield", "label": "t:emasole.options.icon_shield" },
            { "value": "lock", "label": "t:emasole.options.icon_lock" },
            { "value": "tag", "label": "t:emasole.options.icon_tag" },
            { "value": "headset", "label": "t:emasole.options.icon_headset" },
            { "value": "gift", "label": "t:emasole.options.icon_gift" },
            { "value": "package", "label": "t:emasole.options.icon_package" },
            { "value": "badge-check", "label": "t:emasole.options.icon_badge" },
            { "value": "globe", "label": "t:emasole.options.icon_globe" }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:emasole.settings.heading",
          "default": "Free shipping"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:emasole.settings.text",
          "default": "On orders over $29"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:emasole.settings.link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:emasole.names.benefits",
      "category": "t:emasole.names.category",
      "blocks": [
        { "type": "benefit", "settings": { "icon": "truck", "title": "Free shipping", "text": "On orders over $29" } },
        { "type": "benefit", "settings": { "icon": "return", "title": "Free returns", "text": "Within 90 days of delivery" } },
        { "type": "benefit", "settings": { "icon": "tag", "title": "Price adjustment", "text": "Price drops within 30 days? We refund the difference" } },
        { "type": "benefit", "settings": { "icon": "lock", "title": "Secure payments", "text": "Encrypted checkout, trusted providers" } }
      ]
    }
  ]
}
{% endschema %}
