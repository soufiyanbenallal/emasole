{% doc %}
  Renders the Emasole brand mark: a smiling shopping bag on an Ember tile. Used as the
  logo fallback when no logo image is uploaded, and next to the wordmark in the footer.

  @param {number} [size] - Rendered size in pixels (default 32)

  @example
  {% render 'em-logo-mark', size: 36 %}
{% enddoc %}
{%- assign size = size | default: 32 -%}
<svg
  class="em-logo-mark"
  width="{{ size }}"
  height="{{ size }}"
  viewBox="0 0 48 48"
  aria-hidden="true"
  focusable="false"
>
  <rect width="48" height="48" rx="13" fill="#CC3500"/>
  <path d="M16.5 17.5v-1.8a7.5 7.5 0 0 1 15 0v1.8" fill="none" stroke="#FFFFFF" stroke-width="3.4" stroke-linecap="round"/>
  <path d="M11.8 18.6c.2-1.3 1.3-2.2 2.6-2.2h19.2c1.3 0 2.4.9 2.6 2.2l2 17.4c.3 2.1-1.4 4-3.5 4H13.3c-2.1 0-3.8-1.9-3.5-4Z" fill="#FFFFFF"/>
  <path d="M18.2 26.4a6.3 6.3 0 0 0 11.6 0" fill="none" stroke="#CC3500" stroke-width="3.4" stroke-linecap="round"/>
  <circle cx="35.6" cy="12.4" r="3.4" fill="#FFC53D"/>
</svg>
