{% doc %}
  Renders an Emasole interface icon: a branded, soft, and partially colored duotone icon
  that perfectly matches the store's design system (Ember, Mint, Sun, and Ink).

  Decorative by default (`aria-hidden`). Pass `label` when the icon is the only content
  of a control and must be announced to assistive technology.

  @param {string} icon - Icon name:
    search, user, heart, truck, shield, return, tag, bolt, chevron-left, chevron-right,
    chevron-down, star, menu, close, gift, clock, check, headset, grid, percent, lock,
    copy, arrow-right, package, flame, globe, mail, cart-plus, badge-check, sliders,
    plus, minus, home, share, zoom, bag, sparkles, info, eye, trash
  @param {string} [tone] - Tone override: 'trust', 'deal', 'sun', 'brand', 'nav', 'mono'
  @param {string} [class] - Extra classes on the svg element
  @param {string} [label] - Accessible label; omit for decorative icons
  @param {number} [size] - Optional icon dimension in pixels

  @example
  {% render 'em-icon', icon: 'truck' %}
  {% render 'em-icon', icon: 'shield', tone: 'trust' %}
  {% render 'em-icon', icon: 'close', label: 'Close', class: 'em-icon--lg' %}
{% enddoc %}

{%- liquid
  assign effective_tone = tone
  if effective_tone == blank
    case icon
      when 'shield', 'truck', 'return', 'lock', 'badge-check', 'check'
        assign effective_tone = 'trust'
      when 'bolt', 'flame', 'tag', 'percent', 'heart', 'cart-plus', 'gift', 'sparkles', 'bag'
        assign effective_tone = 'deal'
      when 'star'
        assign effective_tone = 'sun'
      when 'chevron-left', 'chevron-right', 'chevron-down', 'plus', 'minus', 'close', 'arrow-right'
        assign effective_tone = 'nav'
      else
        assign effective_tone = 'brand'
    endcase
  endif
-%}

<svg
  class="em-icon em-icon--{{ effective_tone }}{% if class %} {{ class }}{% endif %}"
  viewBox="0 0 24 24"
  fill="currentColor"
  stroke="none"
  focusable="false"
  {% if size %}
    width="{{ size }}"
    height="{{ size }}"
  {% endif %}
  {% if label %}
    role="img" aria-label="{{ label | escape }}"
  {% else %}
    aria-hidden="true"
  {% endif %}
>
