{% doc %}
  Renders a single promo card: a flat color or full background image, paired
  with a title, description, and an optional accent image (only available
  when there's no background image, since the two don't overlay well).
  The whole card is one clickable link. Used inside the hero-promo-grid block.

  @example
  {% content_for 'block', type: 'hero-promo-card', id: 'promo-card' %}
{% enddoc %}

{% liquid
  assign block_settings = block.settings
  assign has_link = false
  if block_settings.link != blank
    assign has_link = true
  endif

  assign has_background_image = false
  if block_settings.background_image != blank
    assign has_background_image = true
  endif

  assign has_background_color = false
  if has_background_image == false and block_settings.background_color != blank
    assign has_background_color = true
  endif

  assign text_color_class = 'hero-promo-card--text-' | append: block_settings.text_color
%}

<div
  class="
    hero-promo-card
    hero-promo-card--image-{{ block_settings.image_position }}
    {% if has_background_image %}hero-promo-card--on-image{% endif %}
    {{ text_color_class }}
  "
  style="
    {% if has_background_color %}
      background-color: {{ block_settings.background_color }};
    {% endif %}
  "
  {{ block.shopify_attributes }}
>
  {% if has_link %}
    <a
      href="{{ block_settings.link }}"
      class="hero-promo-card__link"
      {% if block_settings.open_in_new_tab %}
        target="_blank" rel="noopener"
      {% endif %}
      aria-label="{{ block_settings.title | strip_html }}"
    ></a>
  {% endif %}

  {% if has_background_image %}
    {{
      block_settings.background_image
      | image_url: width: 1200
      | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, 50vw', class: 'hero-promo-card__background'
    }}
    <div class="hero-promo-card__scrim"></div>
  {% endif %}

  <div class="hero-promo-card__body">
    <div class="hero-promo-card__text">
      {% if block_settings.title != blank %}
        <p class="hero-promo-card__title">{{ block_settings.title }}</p>
      {% endif %}
      {% if block_settings.description != blank %}
        <p class="hero-promo-card__description">{{ block_settings.description }}</p>
      {% endif %}
    </div>

    {% if has_background_image == false and block_settings.image != blank %}
      <div class="hero-promo-card__image-wrap">
        {{
          block_settings.image
          | image_url: width: 400
          | image_tag: loading: 'lazy', sizes: '160px', class: 'hero-promo-card__image'
        }}
      </div>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .hero-promo-card {
    position: relative;
    display: flex;
    height: 100%;
    min-height: var(--hero-promo-card-min-height, 9rem);
    overflow: hidden;
    border-radius: var(--style-border-radius-lg);
  }

  .hero-promo-card--text-light {
    color: var(--palette-lightest);
  }

  .hero-promo-card--text-dark {
    color: var(--palette-darkest);
  }

  .hero-promo-card__link {
    position: absolute;
    inset: 0;
    z-index: var(--layer-raised);
  }

  .hero-promo-card__background {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Scrim direction mirrors the chosen text color, so it deepens contrast
     instead of fighting it: dark scrim under light text, light scrim under
     dark text — both strongest at the bottom, where the content sits. */
  .hero-promo-card__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 0 0 / 0.45), rgb(0 0 0 / 0.1));
  }

  .hero-promo-card--text-dark .hero-promo-card__scrim {
    background: linear-gradient(to top, rgb(255 255 255 / 0.55), rgb(255 255 255 / 0.15));
  }

  .hero-promo-card__body {
    position: relative;
    z-index: var(--layer-flat);
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--gap-sm);
    width: 100%;
    padding: var(--padding-md);
  }

  .hero-promo-card--image-left .hero-promo-card__body {
    flex-direction: row-reverse;
  }

  .hero-promo-card__text {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xs, 2px);
    min-width: 0;
  }

  .hero-promo-card__title {
    margin: 0;
    font-size: var(--hero-promo-card-title-size, inherit);
    font-weight: var(--font-weight-semibold);
    transition: font-size var(--animation-speed) var(--animation-easing);
  }

  .hero-promo-card__description {
    margin: 0;
    font-size: var(--font-size--sm);
    opacity: var(--opacity-70);
  }

  .hero-promo-card__image-wrap {
    flex-shrink: 0;
    width: 5.5rem;
  }

  .hero-promo-card__image {
    width: 100%;
    height: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.hero_promo_card",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "Category"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:settings.description"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    },
    {
      "type": "header",
      "content": "t:settings.text_color"
    },
    {
      "type": "select",
      "id": "text_color",
      "label": "t:settings.text_color",
      "options": [
        { "value": "light", "label": "t:options.text_color_light" },
        { "value": "dark", "label": "t:options.text_color_dark" }
      ],
      "default": "light"
    },
    {
      "type": "header",
      "content": "t:content.background_image"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:content.background_image",
      "info": "t:info.hero_promo_card_background_image"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#3F6E8C",
      "visible_if": "{{ block.settings.background_image == blank }}"
    },
    {
      "type": "header",
      "content": "t:settings.image"
    },
    {
      "type": "paragraph",
      "content": "t:info.hero_promo_card_accent_image",
      "visible_if": "{{ block.settings.background_image == blank }}"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "visible_if": "{{ block.settings.background_image == blank }}"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:settings.image_position",
      "options": [
        { "value": "left", "label": "t:options.left" },
        { "value": "right", "label": "t:options.right" }
      ],
      "default": "right",
      "visible_if": "{{ block.settings.background_image == blank }}"
    }
  ],
  "presets": [{ "name": "t:names.hero_promo_card" }]
}
{% endschema %}
