{% doc %}
  Renders a single icon + title + description row for the hero-trust-panel
  block. Purely informational (not a navigation link) unless a link is set.

  @example
  {% content_for 'block', type: 'hero-trust-item', id: 'trust-item' %}
{% enddoc %}

{% liquid
  assign block_settings = block.settings
  assign icon_class = 'hero-trust-item__icon'
  if block_settings.icon_color != blank
    assign icon_class = icon_class | append: ' hero-trust-item-' | append: block.id
  endif
%}

{% if block_settings.icon_color != blank %}
  {% style %}
    .hero-trust-item-{{ block.id }} {
      color: {{ block_settings.icon_color }};
    }
  {% endstyle %}
{% endif %}

{% capture content %}
  {% render 'icon-or-image',
    icon: block_settings.icon,
    image_upload: block_settings.image_upload,
    width: 28,
    class_name: icon_class
  %}
  <div class="hero-trust-item__text">
    {% if block_settings.title != blank %}
      <p class="hero-trust-item__title">{{ block_settings.title }}</p>
    {% endif %}
    {% if block_settings.description != blank %}
      <p class="hero-trust-item__description">{{ block_settings.description }}</p>
    {% endif %}
  </div>
{% endcapture %}

<li
  class="hero-trust-item"
  {{ block.shopify_attributes }}
>
  {% if block_settings.link != blank %}
    <a
      href="{{ block_settings.link }}"
      class="hero-trust-item__link"
      {% if block_settings.open_in_new_tab %}
        target="_blank" rel="noopener"
      {% endif %}
    >
      {{ content }}
    </a>
  {% else %}
    {{ content }}
  {% endif %}
</li>

{% stylesheet %}
  .hero-trust-item__link {
    display: contents;
    color: currentcolor;
    text-decoration: none;
  }

  .hero-trust-item {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-sm);
  }

  .hero-trust-item__icon {
    flex-shrink: 0;
    margin-block-start: 2px;
  }

  .hero-trust-item__text {
    display: flex;
    flex-direction: column;
    gap: var(--gap-3xs, 2px);
  }

  .hero-trust-item__title {
    margin: 0;
    font-weight: var(--font-weight-medium);
  }

  .hero-trust-item__description {
    margin: 0;
    color: rgb(var(--color-foreground-rgb) / var(--opacity-subdued-text));
    font-size: var(--font-size--sm);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.hero_trust_item",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "lock", "label": "t:options.lock" },
        { "value": "check_box", "label": "t:options.check_box" },
        { "value": "truck", "label": "t:options.truck" },
        { "value": "return", "label": "t:options.return" },
        { "value": "heart", "label": "t:options.heart" },
        { "value": "star", "label": "t:options.star" },
        { "value": "recycle", "label": "t:options.recycle" },
        { "value": "map_pin", "label": "t:options.map_pin" },
        { "value": "price_tag", "label": "t:options.price_tag" },
        { "value": "stopwatch", "label": "t:options.stopwatch" },
        { "value": "chat_bubble", "label": "t:options.chat_bubble" },
        { "value": "eye", "label": "t:options.eye" },
        { "value": "lightning_bolt", "label": "t:options.lightning_bolt" },
        { "value": "question_mark", "label": "t:options.question_mark" }
      ],
      "default": "check_box"
    },
    {
      "type": "image_picker",
      "id": "image_upload",
      "label": "t:settings.image_icon"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "Secure privacy"
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:settings.description",
      "default": "Your data is protected at every step."
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_new_tab",
      "default": false
    }
  ],
  "presets": [{ "name": "t:names.hero_trust_item" }]
}
{% endschema %}
